<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="EditorShell.uss" />
    <ui:VisualElement name="app-root" class="app-root">
        <ui:VisualElement name="toolbar" class="menu-bar">
            <ui:Label text="OMSI Map Editor" class="brand" />
            <ui:VisualElement class="menu-container">
                <ui:Button name="file-menu-button" text="File" class="toolbar-menu-button" />
                <ui:Button name="edit-menu-button" text="Edit" class="toolbar-menu-button" />
                <ui:Button name="view-menu-button" text="View" class="toolbar-menu-button" />
                <ui:Button name="tools-menu-button" text="Tools" class="toolbar-menu-button" tooltip="Check the loaded map: import warnings and whether connected splines meet." />
                <ui:Button name="help-menu-button" text="Help" class="toolbar-menu-button" />
            </ui:VisualElement>
            <ui:Label name="map-title" class="menu-bar-map" />
        </ui:VisualElement>
        <ui:VisualElement name="workspace" class="workspace">
            <ui:VisualElement name="map-view" class="map-view" />
            <ui:VisualElement name="empty-state" class="empty-state">
                <ui:Label text="No map loaded" class="empty-state-title" />
                <ui:Label text="Open the global.cfg of an OMSI map to view it, or a Mapforge project to edit it." class="empty-state-text" />
                <ui:Button name="empty-state-open-button" text="Open OMSI map..." class="primary-button" />
            </ui:VisualElement>
            <ui:VisualElement name="project-frame" class="floating-panel project-frame">
                <ui:VisualElement class="floating-panel-header">
                    <ui:Label text="Project" class="floating-panel-title" />
                    <ui:Button name="project-collapse-button" class="panel-collapse-button" tooltip="Collapse the project browser" />
                </ui:VisualElement>
                <ui:VisualElement name="project-panel" class="floating-panel-content">
                    <ui:Label text="No map loaded" class="muted" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inspector-frame" class="floating-panel inspector-frame">
                <ui:VisualElement class="floating-panel-header">
                    <ui:Label text="Inspector" class="floating-panel-title" />
                    <ui:Button name="inspector-collapse-button" class="panel-collapse-button" tooltip="Collapse the inspector" />
                </ui:VisualElement>
                <ui:VisualElement name="inspector-panel" class="floating-panel-content">
                    <ui:Label text="Select an item to inspect its properties." class="muted" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tool-panel-host" class="tool-panel-host" picking-mode="Ignore" style="display: none;" />
            <ui:VisualElement name="tool-bar-host" class="tool-bar-host" picking-mode="Ignore" style="display: none;" />
            <ui:VisualElement name="map-controls" class="view-controls" style="display: none;">
                <ui:Button name="fit-map-button" class="view-control-button view-control-icon-only" tooltip="Fit map: show the whole map" />
                <ui:Button name="zoom-out-button" class="view-control-button view-control-icon-only" tooltip="Zoom out (mouse wheel)" />
                <ui:Label name="zoom-label" text="Fit" class="zoom-label" />
                <ui:Button name="zoom-in-button" class="view-control-button view-control-icon-only" tooltip="Zoom in (mouse wheel)" />
                <ui:Button name="center-selection-button" class="view-control-button view-control-icon-only" tooltip="Center selection: move the view to the selected object or tile" />
                <ui:VisualElement class="view-control-separator" />
                <ui:Button name="ground-toggle-button" text="Textures" class="view-control-button view-control-active" tooltip="Show the ground and objects textured, or plain tiles with outlines. The 3D view always shows textures." />
                <ui:Button name="view3d-button" text="3D" class="view-control-button" tooltip="Look at and edit the map in 3D: right drag turns, middle drag moves, the wheel zooms." />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="file-menu" class="menu-popup file-menu">
            <ui:Button name="open-project-menu-item" text="Open Mapforge project..." class="menu-popup-item" />
            <ui:Button name="save-project-menu-item" text="Save map project as..." class="menu-popup-item" />
            <ui:Button name="export-menu-item" text="Export to OMSI..." class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Button name="open-map-menu-item" text="Open OMSI map..." class="menu-popup-item" />
        </ui:VisualElement>
        <ui:VisualElement name="edit-menu" class="menu-popup edit-menu">
            <ui:Button name="place-object-menu-item" text="Place object..." class="menu-popup-item" />
            <ui:Button name="delete-object-menu-item" text="Delete selection    Del" class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Button name="undo-menu-item" text="Undo    Ctrl+Z" class="menu-popup-item" />
            <ui:Button name="redo-menu-item" text="Redo    Ctrl+Y" class="menu-popup-item" />
        </ui:VisualElement>
        <ui:VisualElement name="view-menu" class="menu-popup view-menu">
            <ui:Button name="project-panel-menu-item" text="Project browser" class="menu-popup-item" />
            <ui:Button name="inspector-menu-item" text="Inspector" class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Label text="Colours in the view from above" class="menu-section-label" />
            <ui:VisualElement name="map-legend" class="map-legend">
                <ui:Label text="Splines" class="map-legend-spline" />
                <ui:Label text="Objects" class="map-legend-object" />
                <ui:Label text="Trees" class="map-legend-tree" />
                <ui:Label text="Selected" class="map-legend-selected" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="help-menu" class="menu-popup help-menu">
            <ui:Label text="OMSI Map Editor" class="popup-title" />
            <ui:Label name="map-hint" class="popup-description help-controls" style="display: none;" />
            <ui:Label text="Select File, then Open OMSI map... to read a global.cfg directly from the OMSI installation." class="popup-description" />
            <ui:Label text="Save map project as... stores a small project file that points back to this external global.cfg." class="popup-description" />
            <ui:Label text="With a project, click an object in the map or in the inspector list to edit its position and orientation. Edits are saved to the project's workspace; the original map is not changed." class="popup-description" />
            <ui:Label text="Objects (3) opens the object library: browse the Sceneryobjects folders, the objects of this map or your favorites, click one and click into the map to place it. Del deletes the selected object unless other parts of the map still refer to it." class="popup-description" />
            <ui:Label text="Ctrl+click adds objects to the selection or removes them; Ctrl+drag on empty space selects all objects in a box. Dragging one selected object moves all of them. An object moved over a tile border moves into that tile." class="popup-description" />
            <ui:Label text="Export to OMSI... writes the original map plus your edits as a separate map folder next to the original." class="popup-description" />
            <ui:Label text="OMSI game files are read in place and are not bundled with the application." class="popup-description" />
            <ui:Button name="help-menu-close-button" text="Close" class="menu-popup-item popup-close" />
        </ui:VisualElement>
        <ui:VisualElement name="export-dialog" class="dialog-overlay" style="display: none;">
            <ui:VisualElement class="dialog">
                <ui:Label text="Export to OMSI" class="popup-title" />
                <ui:Label text="Writes the original map plus the edits of this project as a separate map folder next to the original. The original map is not changed." class="popup-description" />
                <ui:TextField name="export-folder-field" label="Folder name" class="dialog-field" />
                <ui:TextField name="export-name-field" label="Name in OMSI" class="dialog-field" />
                <ui:Label name="export-target-label" class="popup-description export-target" />
                <ui:VisualElement class="dialog-buttons">
                    <ui:Button name="export-cancel-button" text="Cancel" class="map-control-button" />
                    <ui:Button name="export-confirm-button" text="Export" class="map-control-button dialog-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="status-bar">
            <ui:Label name="pointer-info" class="status-pointer" />
            <ui:Label name="selection-info" class="status-selection" />
            <ui:Label name="status-message" text="Ready" class="status-message" />
            <ui:Label name="map-state" text="No map loaded" class="status-map-state" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
