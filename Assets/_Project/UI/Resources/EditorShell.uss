.app-root { width: 100%; height: 100%; min-height: 100%; flex-grow: 1; align-items: stretch; background-color: rgba(0, 0, 0, 0); color: rgb(226, 231, 237); }
.toolbar { height: 44px; min-height: 44px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 16px; padding-right: 16px; background-color: rgb(34, 39, 47); border-bottom-width: 1px; border-bottom-color: rgb(55, 63, 73); }
.brand { -unity-font-style: bold; font-size: 15px; }
.menu-container { margin-left: 24px; flex-direction: row; align-items: center; position: relative; }
.toolbar-menu-button { min-width: 54px; height: 32px; margin: 0 2px; padding-left: 10px; padding-right: 10px; color: rgb(218, 225, 233); background-color: rgba(0, 0, 0, 0); border-width: 0; }
.toolbar-menu-button:hover { background-color: rgb(52, 60, 70); }
.toolbar-menu-button:disabled { color: rgb(108, 117, 127); }
.menu-popup { position: absolute; top: 46px; min-width: 230px; padding: 8px; background-color: rgb(39, 45, 53); border-width: 1px; border-color: rgb(68, 78, 90); z-index: 100; display: none; }
.file-menu { left: 178px; }
.edit-menu { left: 236px; }
.help-menu { left: 420px; width: 320px; }
.menu-popup-item { height: 34px; -unity-text-align: middle-left; padding-left: 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(226, 231, 237); }
.menu-popup-item:hover { background-color: rgb(61, 71, 82); }
.menu-divider { height: 1px; margin: 5px 4px; background-color: rgb(68, 78, 90); }
.popup-title { margin: 4px 8px 8px; -unity-font-style: bold; }
.popup-description { margin: 4px 8px; color: rgb(183, 192, 203); white-space: normal; }
.popup-close { align-self: flex-end; min-width: 68px; -unity-text-align: middle-center; }
.workspace { flex-grow: 1; min-height: 0; flex-direction: row; }
.side-panel { width: 240px; padding: 14px; background-color: rgb(31, 36, 43); border-right-width: 1px; border-right-color: rgb(55, 63, 73); }
.inspector { border-right-width: 0; border-left-width: 1px; }
.panel-heading { margin-bottom: 14px; font-size: 11px; -unity-font-style: bold; color: rgb(177, 190, 205); }
.browser-map-name { margin-bottom: 5px; -unity-font-style: bold; color: rgb(225, 194, 137); white-space: normal; }
.browser-project-name { margin-bottom: 8px; font-size: 11px; color: rgb(143, 209, 240); white-space: normal; }
.browser-map-counts { margin-bottom: 12px; font-size: 10px; color: rgb(160, 173, 187); white-space: normal; }
.browser-tile-list { flex-grow: 1; min-height: 0; }
.browser-tile-entry { min-height: 30px; margin-bottom: 3px; padding-left: 7px; padding-right: 4px; -unity-text-align: middle-left; font-size: 10px; color: rgb(209, 219, 228); background-color: rgb(38, 45, 53); border-width: 1px; border-color: rgb(55, 65, 76); }
.browser-tile-entry:hover { background-color: rgb(51, 63, 74); }
.browser-tile-entry-selected { background-color: rgb(63, 78, 89); border-color: rgb(225, 175, 83); }
.browser-tile-entry-missing { color: rgb(240, 164, 154); }
.viewport { flex-grow: 1; min-width: 0; min-height: 0; flex-direction: column; background-color: rgba(0, 0, 0, 0); overflow: hidden; }
.map-header { flex-shrink: 0; padding: 14px 20px 0; background-color: rgb(20, 24, 29); }
.primary-button { margin-top: 20px; height: 36px; padding-left: 16px; padding-right: 16px; background-color: rgb(45, 100, 142); color: white; border-width: 0; }
.map-title { align-self: flex-start; margin-bottom: 8px; font-size: 20px; -unity-font-style: bold; }
.map-counts { align-self: flex-start; margin-bottom: 8px; color: rgb(183, 197, 211); }
.map-description { align-self: flex-start; margin-bottom: 14px; color: rgb(153, 165, 178); white-space: normal; }
.map-legend { align-self: flex-start; flex-direction: row; margin-bottom: 8px; }
.map-legend-spline { margin-right: 16px; color: rgb(242, 181, 77); }
.map-legend-object { margin-right: 0; color: rgb(143, 209, 240); }
.map-controls { flex-direction: row; align-items: center; margin-bottom: 8px; }
.map-control-button { height: 28px; margin-right: 6px; padding-left: 10px; padding-right: 10px; color: rgb(218, 225, 233); background-color: rgb(40, 48, 57); border-width: 1px; border-color: rgb(63, 75, 87); }
.map-control-button:hover { background-color: rgb(55, 67, 78); }
.map-zoom-button { min-width: 30px; padding-left: 6px; padding-right: 6px; -unity-text-align: middle-center; }
.zoom-label { min-width: 42px; margin-right: 6px; -unity-text-align: middle-center; font-size: 11px; color: rgb(183, 197, 211); }
.viewport-label { margin-bottom: 8px; font-size: 12px; -unity-font-style: bold; color: rgb(133, 157, 180); }
.inspector-title { margin-bottom: 10px; -unity-font-style: bold; color: rgb(225, 194, 137); }
.inspector-property { margin-bottom: 7px; }
.inspector-property-name { margin-bottom: 2px; font-size: 10px; color: rgb(139, 154, 169); }
.inspector-property-value { font-size: 11px; color: rgb(216, 224, 232); white-space: normal; }
.inspector-records { flex-grow: 1; min-height: 0; margin-top: 10px; border-top-width: 1px; border-top-color: rgb(55, 63, 73); }
.inspector-section-heading { margin-top: 10px; margin-bottom: 5px; font-size: 10px; -unity-font-style: bold; color: rgb(177, 190, 205); }
.inspector-record { margin-bottom: 4px; padding: 5px; font-size: 10px; color: rgb(205, 215, 224); background-color: rgb(38, 45, 53); white-space: normal; }
.inspector-record-empty { margin-bottom: 5px; font-size: 10px; color: rgb(139, 149, 161); }
.muted { color: rgb(139, 149, 161); white-space: normal; }
.status-bar { height: 26px; min-height: 26px; flex-shrink: 0; flex-direction: row; justify-content: space-between; padding-left: 10px; padding-right: 10px; align-items: center; background-color: rgb(42, 48, 57); color: rgb(187, 197, 208); font-size: 11px; }
.browser-tile-entry-edited { border-left-width: 3px; border-left-color: rgb(255, 92, 107); }
.inspector-record-clickable:hover { background-color: rgb(51, 63, 74); }
.inspector-record-selected { background-color: rgb(63, 78, 89); border-left-width: 3px; border-left-color: rgb(255, 92, 107); }
.inspector-edit { margin-top: 10px; padding: 8px; background-color: rgb(38, 45, 53); border-width: 1px; border-color: rgb(69, 87, 101); }
.inspector-edit-name { margin-bottom: 6px; font-size: 10px; color: rgb(216, 224, 232); white-space: normal; }
.inspector-edit-field { margin: 2px 0; font-size: 11px; }
.inspector-edit-field > Label { min-width: 74px; width: 74px; font-size: 10px; color: rgb(139, 154, 169); }
.inspector-edit-apply { margin-top: 6px; align-self: flex-start; }
.inspector-edit-revert { margin-top: 6px; align-self: flex-start; }
.inspector-edit-hint { margin-top: 6px; font-size: 10px; }
.dialog-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(10, 12, 15, 0.7); }
.dialog { width: 560px; padding: 16px; background-color: rgb(39, 45, 53); border-width: 1px; border-color: rgb(68, 78, 90); }
.dialog-field { margin: 4px 8px; }
.dialog-field > Label { min-width: 110px; width: 110px; color: rgb(183, 192, 203); }
.export-target { margin-top: 8px; color: rgb(143, 209, 240); }
.export-problem { color: rgb(240, 164, 154); }
.dialog-buttons { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
.dialog-primary { background-color: rgb(45, 100, 142); border-color: rgb(45, 100, 142); color: white; }
.inspector-edit-field .unity-base-text-field__input, .dialog-field .unity-base-text-field__input { background-color: rgb(24, 28, 34); color: rgb(226, 231, 237); border-color: rgb(69, 87, 101); }
.inspector-edit-field .unity-base-text-field__input:focus, .dialog-field .unity-base-text-field__input:focus { border-color: rgb(225, 175, 83); }
.map-view { flex-grow: 1; min-height: 0; margin: 0 20px 12px; position: relative; overflow: hidden; background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgb(45, 53, 62); }
.map-canvas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-overlay { position: absolute; left: 8px; bottom: 6px; padding: 2px 6px; font-size: 10px; color: rgb(183, 197, 211); background-color: rgba(15, 18, 22, 0.85); }
.map-angle-label { position: absolute; padding: 2px 6px; font-size: 11px; color: rgb(232, 238, 244); background-color: rgba(15, 18, 22, 0.85); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
.map-warnings { align-self: flex-start; margin-bottom: 8px; font-size: 11px; color: rgb(238, 190, 110); white-space: normal; }
.map-hint { margin-left: 10px; font-size: 10px; color: rgb(139, 154, 169); white-space: normal; flex-shrink: 1; }
.map-legend-selected { margin-left: 16px; color: rgb(255, 92, 107); }
.map-legend-tree { margin-left: 16px; color: rgb(115, 199, 128); }
.menu-popup-item:disabled { color: rgb(108, 117, 127); }
.place-dialog { width: 640px; }
.place-list { height: 320px; margin: 6px 8px; background-color: rgb(24, 28, 34); border-width: 1px; border-color: rgb(69, 87, 101); }
.place-list-item { padding-left: 6px; -unity-text-align: middle-left; font-size: 11px; color: rgb(209, 219, 228); }
.place-info { margin-top: 6px; font-size: 11px; color: rgb(143, 209, 240); }
.inspector-edit-delete { margin-top: 6px; align-self: flex-start; color: rgb(240, 164, 154); }
