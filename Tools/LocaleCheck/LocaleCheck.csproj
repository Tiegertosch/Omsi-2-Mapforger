<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the language files without Unity. The checking code is the program's own: it is compiled from the sources of Editor.Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>LocaleCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Core\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
