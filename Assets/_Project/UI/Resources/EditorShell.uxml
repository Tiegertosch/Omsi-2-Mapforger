<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="EditorShell.uss" />
    <ui:VisualElement name="app-root" class="app-root">
        <ui:VisualElement name="toolbar" class="menu-bar">
            <ui:Label text="OMSI MapWorks" class="brand" />
            <ui:VisualElement class="menu-container">
                <ui:Button name="file-menu-button" text="File" class="toolbar-menu-button" />
                <ui:Button name="edit-menu-button" text="Edit" class="toolbar-menu-button" />
                <ui:Button name="view-menu-button" text="Tools" class="toolbar-menu-button" />
                <ui:Button name="help-menu-button" text="Help" class="toolbar-menu-button" />
            </ui:VisualElement>
            <ui:Label name="map-title" class="menu-bar-map" />
        </ui:VisualElement>
        <ui:VisualElement name="workspace" class="workspace">
            <ui:VisualElement name="map-view" class="map-view" />
            <ui:VisualElement name="empty-state" class="empty-state" />
            <ui:VisualElement name="inspector-frame" class="floating-panel inspector-frame" style="display: none;">
                <ui:VisualElement class="floating-panel-header">
                    <ui:Label name="inspector-title" text="Inspector" class="floating-panel-title" />
                    <ui:Button name="inspector-collapse-button" class="panel-collapse-button" tooltip="Close the inspector" />
                </ui:VisualElement>
                <ui:VisualElement name="inspector-panel" class="floating-panel-content">
                    <ui:Label name="inspector-empty" text="Select an item to inspect its properties." class="muted" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tool-panel-host" class="tool-panel-host" picking-mode="Ignore" style="display: none;" />
            <ui:VisualElement name="bar-popup" class="floating-panel bar-popup" style="display: none;">
                <ui:VisualElement class="floating-panel-header">
                    <ui:Label name="project-title" text="Project" class="floating-panel-title" />
                    <ui:Button name="project-collapse-button" class="panel-collapse-button" tooltip="Close" />
                </ui:VisualElement>
                <ui:VisualElement name="project-panel" class="floating-panel-content">
                    <ui:Label name="project-empty" text="No map loaded" class="muted" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-bar" class="bottom-bar bottom-bar-empty">
                <ui:VisualElement name="map-controls" class="view-controls" style="display: none;">
                    <ui:VisualElement class="view-controls-row">
                        <ui:Button name="routes-toggle-button" text="Routes" class="view-control-button" tooltip="Show the bus stops and the routes of the timetable lines in the view from above. Lines are listed in the project browser." />
                    </ui:VisualElement>
                    <ui:VisualElement class="view-controls-row">
                        <ui:Button name="ground-toggle-button" text="Textures" class="view-control-button view-control-active" tooltip="Show the ground and objects textured, or plain tiles with outlines. The 3D view always shows textures." />
                        <ui:Button name="view3d-button" text="3D" class="view-control-button" tooltip="Look at and edit the map in 3D: right drag turns, middle drag moves, the wheel zooms." />
                    </ui:VisualElement>
                    <ui:VisualElement class="view-controls-row">
                        <ui:Button name="fit-map-button" class="view-control-button view-control-icon-only" tooltip="Fit map: show the whole map" />
                        <ui:Button name="zoom-out-button" class="view-control-button view-control-icon-only" tooltip="Zoom out (mouse wheel)" />
                        <ui:Label name="zoom-label" text="Fit" class="zoom-label" />
                        <ui:Button name="zoom-in-button" class="view-control-button view-control-icon-only" tooltip="Zoom in (mouse wheel)" />
                        <ui:Button name="center-selection-button" class="view-control-button view-control-icon-only" tooltip="Center selection: move the view to the selected object or tile" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="bar-main">
                    <ui:VisualElement name="bar-row" class="bar-row" style="display: none;">
                        <ui:VisualElement name="bar-left" class="bar-group" />
                        <ui:VisualElement name="tool-bar-host" class="tool-bar-host" />
                        <ui:VisualElement name="bar-right" class="bar-group" />
                    </ui:VisualElement>
                    <ui:VisualElement class="status-bar">
                        <ui:Label name="pointer-info" class="status-pointer" />
                        <ui:Label name="selection-info" class="status-selection" />
                        <ui:Label name="status-message" text="Ready" class="status-message" />
                        <ui:Label name="tool-hint" class="status-hint" />
                        <ui:Label name="map-state" text="No map loaded" class="status-map-state" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="file-menu" class="menu-popup file-menu">
            <ui:Button name="new-map-menu-item" text="New map..." class="menu-popup-item" />
            <ui:Button name="open-project-menu-item" text="Open MapWorks project..." class="menu-popup-item" />
            <ui:Button name="save-project-menu-item" text="Save map project as..." class="menu-popup-item" />
            <ui:Button name="export-menu-item" text="Export to OMSI..." class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Button name="open-map-menu-item" text="Open OMSI map..." class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Button name="settings-menu-item" text="Settings..." class="menu-popup-item" />
        </ui:VisualElement>
        <ui:VisualElement name="edit-menu" class="menu-popup edit-menu">
            <ui:Button name="place-object-menu-item" text="Place object..." class="menu-popup-item" />
            <ui:Button name="delete-object-menu-item" text="Delete selection    Del" class="menu-popup-item" />
            <ui:Button name="refit-terrain-menu-item" text="Fit terrain to built roads again" class="menu-popup-item" />
            <ui:Button name="test-junction-menu-item" text="Create test junction from road profile" class="menu-popup-item" tooltip="Makes a straight 12 m junction object in the profile chosen in the road tool, under Sceneryobjects\Mapforge in your OMSI installation, and starts placing it." />
            <ui:Button name="tee-junction-menu-item" text="Create T junction from road profile" class="menu-popup-item" tooltip="Makes a T junction with rounded kerbs, pavements and lanes for every way through in the profile chosen in the road tool, and starts placing it." />
            <ui:Button name="cross-junction-menu-item" text="Create crossroads from road profile" class="menu-popup-item" tooltip="Makes a junction of four arms with rounded kerbs, pavements and lanes for every way through in the profile chosen in the road tool, and starts placing it." />
            <ui:Label class="menu-divider" />
            <ui:Button name="undo-menu-item" text="Undo    Ctrl+Z" class="menu-popup-item" />
            <ui:Button name="redo-menu-item" text="Redo    Ctrl+Y" class="menu-popup-item" />
        </ui:VisualElement>
        <ui:VisualElement name="view-menu" class="menu-popup view-menu">
            <ui:Button name="inspector-menu-item" text="Inspector" class="menu-popup-item" />
            <ui:Button name="satellite-menu-item" text="Satellite and terrain..." class="menu-popup-item" tooltip="Place the map on the Earth and load pictures from the air and terrain heights for its tiles, without any key, as openMapper does." />
            <ui:Button name="road-builder-menu-item" text="Road builder..." class="menu-popup-item" />
            <ui:Label class="menu-divider" />
            <ui:Button name="check-map-menu-item" text="Check map..." class="menu-popup-item" />
        </ui:VisualElement>
        <ui:VisualElement name="help-menu" class="menu-popup help-menu">
            <ui:Button name="check-updates-menu-item" text="Check for updates..." class="menu-popup-item" tooltip="Look on GitHub for a newer release of MapWorks and install it" />
            <ui:Button name="report-bug-menu-item" text="Report a bug..." class="menu-popup-item" tooltip="Describe a problem and open it as a new issue on GitHub, with the log attached" />
            <ui:Button name="wiki-menu-item" text="Wiki..." class="menu-popup-item" tooltip="Open the MapWorks manual on GitHub in the browser" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
