/* Design tokens from Documentation/CorporateDesign.md; components use these instead of raw values. The fonts are
   Inter Regular and SemiBold in Fonts/, referenced directly because variables do not carry asset references. */
:root {
    --mf-color-bg: #171C23;
    --mf-color-panel: #202630;
    --mf-color-panel-glass: rgba(32, 38, 48, 0.94);
    --mf-color-panel-raised: #29313D;
    --mf-color-panel-hover: #35475A;
    --mf-color-field: #141920;
    --mf-color-border: #414B59;
    --mf-color-border-subtle: #2E3642;
    --mf-color-text-primary: #F2F4F7;
    --mf-color-text-secondary: #AEB8C5;
    --mf-color-text-muted: #7E8A99;
    --mf-color-accent: #F08A32;
    --mf-color-accent-hover: #FF9B45;
    --mf-color-success: #55B887;
    --mf-color-warning: #E6B450;
    --mf-color-error: #E06464;
    --mf-color-info: #65A9D9;

    --mf-space-1: 4px;
    --mf-space-2: 8px;
    --mf-space-3: 12px;
    --mf-space-4: 16px;

    --mf-radius-sm: 4px;
    --mf-radius-md: 6px;
    --mf-radius-lg: 8px;

    --mf-font-heading: 14px;
    --mf-font-body: 13px;
    --mf-font-secondary: 11px;
}

/* Application frame */
.app-root { width: 100%; height: 100%; min-height: 100%; flex-grow: 1; align-items: stretch; background-color: rgba(0, 0, 0, 0); color: var(--mf-color-text-primary); font-size: var(--mf-font-body); -unity-font: url("Fonts/Inter-Regular.ttf"); }
.menu-bar { height: 36px; min-height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: var(--mf-space-4); padding-right: var(--mf-space-4); background-color: var(--mf-color-panel); border-bottom-width: 1px; border-bottom-color: var(--mf-color-border-subtle); }
.brand { -unity-font: url("Fonts/Inter-SemiBold.ttf"); font-size: var(--mf-font-heading); }
.menu-container { margin-left: 24px; flex-direction: row; align-items: center; position: relative; }
.toolbar-menu-button { min-width: 50px; height: 28px; margin: 0 2px; padding-left: 10px; padding-right: 10px; color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.toolbar-menu-button:hover { background-color: var(--mf-color-panel-hover); }
.toolbar-menu-button:disabled { color: var(--mf-color-text-muted); }
.menu-bar-map { flex-grow: 1; -unity-text-align: middle-right; color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Menus and popups */
.menu-popup { position: absolute; top: 38px; min-width: 230px; padding: var(--mf-space-2); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); display: none; }
.file-menu { left: 168px; }
.edit-menu { left: 222px; }
.view-menu { left: 276px; }
.help-menu { left: 384px; width: 360px; }
.menu-popup-item { height: 32px; -unity-text-align: middle-left; padding-left: 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); color: var(--mf-color-text-primary); }
.menu-popup-item:hover { background-color: var(--mf-color-panel-hover); }
.menu-popup-item:disabled { color: var(--mf-color-text-muted); }
.menu-popup-item-checked { color: var(--mf-color-accent); }
.menu-divider { height: 1px; margin: 5px 4px; background-color: var(--mf-color-border); }
.menu-section-label { margin: 4px 10px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.popup-title { margin: 4px 8px 8px; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.popup-description { margin: 4px 8px; color: var(--mf-color-text-secondary); white-space: normal; }
.help-controls { margin-bottom: var(--mf-space-2); padding: var(--mf-space-2); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-sm); }
.popup-close { align-self: flex-end; min-width: 68px; -unity-text-align: middle-center; }
.map-legend { flex-direction: row; flex-wrap: wrap; margin: 4px 10px 6px; }
.map-legend > Label { margin-right: var(--mf-space-3); font-size: var(--mf-font-secondary); }
.map-legend-spline { color: var(--mf-color-accent); }
.map-legend-object { color: var(--mf-color-info); }
.map-legend-tree { color: var(--mf-color-success); }
.map-legend-selected { color: var(--mf-color-error); }
.map-legend-wire { color: var(--mf-color-text-secondary); }
.map-legend-fence { color: var(--mf-color-text-muted); }
.map-legend-route { color: var(--mf-color-text-primary); }

/* Workspace: the map fills it, panels and controls float above it */
.workspace { flex-grow: 1; min-height: 0; position: relative; overflow: hidden; background-color: rgba(0, 0, 0, 0); }
.map-view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; background-color: rgba(0, 0, 0, 0); }
.map-canvas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; --map-tile: var(--mf-color-panel); --map-tile-border: var(--mf-color-border); --map-tile-missing: var(--mf-color-error); --map-tile-selected: var(--mf-color-warning); --map-spline: var(--mf-color-accent); --map-object: var(--mf-color-info); --map-tree: var(--mf-color-success); --map-selection: var(--mf-color-error); --map-placement: var(--mf-color-success); --map-handle: var(--mf-color-panel-raised); --map-wire: var(--mf-color-text-secondary); --map-fence: var(--mf-color-text-muted); --map-route: var(--mf-color-text-primary); --map-route-quiet: var(--mf-color-text-secondary); }
.map-angle-label { position: absolute; padding: 2px 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-glass); border-radius: var(--mf-radius-sm); }
.empty-state { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
/* Welcome screen in the middle of the empty map */
.welcome { width: 720px; align-items: stretch; }
.welcome-title { font-size: 26px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); -unity-text-align: middle-center; }
.welcome-tagline { margin-top: var(--mf-space-1); margin-bottom: 28px; -unity-text-align: middle-center; color: var(--mf-color-text-secondary); }
.welcome-cards { flex-direction: row; justify-content: space-between; margin-bottom: 28px; }
.welcome-card { width: 228px; height: 168px; margin: 0; padding: var(--mf-space-4); flex-direction: column; align-items: flex-start; justify-content: flex-start; color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.welcome-card:hover { border-color: var(--mf-color-accent); background-color: var(--mf-color-panel-raised); }
.welcome-card:disabled { color: var(--mf-color-text-muted); }
.welcome-card-icon { width: 40px; height: 40px; margin-bottom: var(--mf-space-3); padding: 9px; color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-radius: var(--mf-radius-md); }
.welcome-card:disabled .welcome-card-icon { color: var(--mf-color-text-muted); background-color: var(--mf-color-panel-raised); }
.welcome-card-icon > .icon { flex-grow: 1; }
.welcome-card-title { margin: 0 0 var(--mf-space-1); padding: 0; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.welcome-card-text { margin: 0; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; -unity-text-align: upper-left; }
.welcome-card:disabled .welcome-card-text { color: var(--mf-color-text-muted); }
.welcome-card-badge { position: absolute; top: var(--mf-space-4); right: var(--mf-space-4); padding: 1px 6px; font-size: 10px; color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel-raised); border-radius: var(--mf-radius-sm); }
.welcome-section { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.welcome-recent { padding: var(--mf-space-1); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.welcome-empty { padding: var(--mf-space-3); color: var(--mf-color-text-muted); }
.welcome-recent-row { height: 46px; margin: 0; padding: 0 var(--mf-space-3); flex-direction: row; align-items: center; color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-md); }
.welcome-recent-row:hover { background-color: var(--mf-color-panel-hover); }
.welcome-recent-row:disabled { color: var(--mf-color-text-muted); }
.welcome-recent-icon { width: 18px; height: 18px; margin-right: var(--mf-space-3); color: var(--mf-color-accent); flex-shrink: 0; }
.welcome-recent-row:disabled .welcome-recent-icon { color: var(--mf-color-text-muted); }
.welcome-recent-texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.welcome-recent-texts > Label { margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.welcome-recent-name { -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.welcome-recent-path { font-size: 10px; color: var(--mf-color-text-muted); }
.welcome-recent-kind { margin: 0 0 0 var(--mf-space-3); padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); flex-shrink: 0; }
.primary-button { margin-top: 20px; height: 36px; padding-left: var(--mf-space-4); padding-right: var(--mf-space-4); background-color: var(--mf-color-accent); color: var(--mf-color-bg); -unity-font: url("Fonts/Inter-SemiBold.ttf"); border-width: 0; border-radius: var(--mf-radius-md); }
.primary-button:hover { background-color: var(--mf-color-accent-hover); }

/* Floating panels */
.floating-panel { position: absolute; top: var(--mf-space-2); bottom: var(--mf-space-2); padding: var(--mf-space-3); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.project-frame { left: var(--mf-space-2); width: 270px; }
.inspector-frame { right: var(--mf-space-2); width: 300px; }
.floating-panel-header { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: var(--mf-space-2); }
.floating-panel-title { flex-grow: 1; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.floating-panel-icon { width: 18px; height: 18px; margin-right: var(--mf-space-2); color: var(--mf-color-accent); }
.floating-panel-content { flex-grow: 1; min-height: 0; }
.panel-collapse-button { width: 24px; height: 24px; margin: 0; padding: 3px; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-collapse-button > .icon { flex-grow: 1; }
.panel-collapse-button:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.floating-panel-collapsed { bottom: auto; width: auto; padding-top: var(--mf-space-1); padding-bottom: var(--mf-space-1); }
.floating-panel-collapsed > .floating-panel-header { margin-bottom: 0; }
.floating-panel-collapsed .floating-panel-title { margin-right: var(--mf-space-2); }
.floating-panel-collapsed > .floating-panel-content { display: none; }

/* View controls, top right of the map next to the inspector */
.view-controls { position: absolute; top: var(--mf-space-2); right: 316px; flex-direction: row; align-items: center; padding: var(--mf-space-1); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.view-control-button { height: 28px; margin: 0 2px; padding-left: var(--mf-space-2); padding-right: var(--mf-space-2); color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.view-control-button:hover { background-color: var(--mf-color-panel-hover); }
.view-control-button:disabled { color: var(--mf-color-text-muted); }
.view-control-button { flex-direction: row; align-items: center; }
.view-control-button > .icon { width: 16px; height: 16px; margin-right: 6px; }
.view-control-button > Label { margin: 0; padding: 0; }
.view-control-icon-only { width: 30px; padding-left: 0; padding-right: 0; justify-content: center; }
.view-control-icon-only > .icon { margin-right: 0; }
.view-control-active, .view-control-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); }
.view-control-active:disabled { color: var(--mf-color-bg); background-color: var(--mf-color-accent); opacity: 0.5; }
.view-control-separator { width: 1px; height: 18px; margin: 0 var(--mf-space-1); background-color: var(--mf-color-border); }
.zoom-label { min-width: 52px; -unity-text-align: middle-center; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }

/* Tool bar at the bottom of the map */
.tool-bar-host { position: absolute; left: 0; right: 0; bottom: var(--mf-space-3); flex-direction: row; justify-content: center; }
.tool-bar { flex-direction: row; align-items: stretch; padding: 6px; background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.tool-group { flex-direction: row; }
.tool-separator { width: 1px; margin: 6px var(--mf-space-2); background-color: var(--mf-color-border); }
.tool-button { width: 66px; height: 70px; margin: 0 2px; padding: 6px 2px 4px; flex-direction: column; align-items: center; justify-content: space-between; color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-md); }
.tool-button:hover { background-color: var(--mf-color-panel-hover); }
.tool-button:disabled { color: var(--mf-color-text-muted); }
.tool-button-active, .tool-button-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); }
.tool-icon { width: 22px; height: 22px; flex-shrink: 0; }
.tool-label { font-size: var(--mf-font-secondary); margin: 0; padding: 0; }
.tool-keycap { min-width: 18px; margin: 0; padding: 0 4px; font-size: 10px; -unity-text-align: middle-center; color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel-raised); border-radius: var(--mf-radius-sm); }
.tool-button-active .tool-keycap { color: var(--mf-color-bg); background-color: rgba(23, 28, 35, 0.18); }

/* Tool panels open above the tool bar */
.tool-panel-host { position: absolute; left: 0; right: 0; bottom: 104px; flex-direction: row; justify-content: center; }
.tool-panel { width: 420px; height: 470px; padding: var(--mf-space-3); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.tool-panel-header { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-3); }
.tool-panel-badge { width: 40px; height: 40px; margin-right: var(--mf-space-3); align-items: center; justify-content: center; color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-radius: var(--mf-radius-md); }
.tool-panel-badge > .icon { width: 24px; height: 24px; }
.tool-panel-titles { flex-grow: 1; }
.tool-panel-title { font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.tool-panel-subtitle { font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.panel-icon-button { width: 28px; height: 28px; margin: 0; padding: 4px; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-icon-button:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.panel-icon-button > .icon { flex-grow: 1; }
.panel-tabs { flex-direction: row; margin-bottom: var(--mf-space-2); padding: 3px; background-color: var(--mf-color-field); border-radius: var(--mf-radius-md); }
.panel-tab { flex-grow: 1; height: 30px; margin: 0; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-tab:hover { color: var(--mf-color-text-primary); }
.panel-tab-active, .panel-tab-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.panel-search { margin-bottom: var(--mf-space-2); }
.panel-search-field { margin: 0; }
.panel-search-field .unity-base-text-field__input { height: 32px; padding-left: var(--mf-space-2); padding-right: 30px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.panel-search-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.panel-search-icon { position: absolute; right: 8px; top: 8px; width: 16px; height: 16px; color: var(--mf-color-text-secondary); }
.panel-folder-bar { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.panel-folder-label { flex-grow: 1; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.panel-list { flex-grow: 1; min-height: 0; }
.panel-list .unity-collection-view__item { background-color: rgba(0, 0, 0, 0); border-radius: var(--mf-radius-sm); }
.panel-list .unity-collection-view__item:hover { background-color: var(--mf-color-panel-hover); }
.panel-list .unity-collection-view__item--selected { background-color: var(--mf-color-panel-hover); border-left-width: 3px; border-left-color: var(--mf-color-accent); }
.panel-row { flex-grow: 1; flex-direction: row; align-items: center; padding-left: var(--mf-space-1); padding-right: var(--mf-space-1); }
.panel-row-icon { width: 18px; height: 18px; margin-right: var(--mf-space-2); color: var(--mf-color-text-secondary); flex-shrink: 0; }
.dialog-row { flex-direction: row; align-items: center; margin: 4px 0; }
.check-dialog { width: 760px; max-height: 86%; }
.check-sections { flex-shrink: 1; min-height: 120px; max-height: 560px; margin: 4px 0 8px; }
.check-section { margin: 0 0 var(--mf-space-2); padding: var(--mf-space-2) var(--mf-space-3); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-md); }
.check-section-header { flex-direction: row; align-items: center; }
.check-section-title { flex-grow: 1; margin: 0; -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.check-status { margin: 0 var(--mf-space-2) 0 0; padding: 1px 6px; font-size: 10px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); border-radius: var(--mf-radius-sm); }
.check-status-passed { background-color: var(--mf-color-success); }
.check-status-note { background-color: var(--mf-color-warning); }
.check-status-problem { background-color: var(--mf-color-error); }
.check-section-summary { margin: 2px 0 0; white-space: normal; color: var(--mf-color-text-secondary); }
.check-finding { margin: 1px 0 0 var(--mf-space-3); font-size: var(--mf-font-secondary); white-space: normal; color: var(--mf-color-text-secondary); }
.check-section-button { height: 24px; margin: 0 0 0 var(--mf-space-2); }
.check-more-button { align-self: flex-start; height: 22px; margin: 2px 0 0 var(--mf-space-3); font-size: var(--mf-font-secondary); }
.dialog-row-text { flex-grow: 1; flex-shrink: 1; margin: 0 8px; }
.panel-row-thumbnail { width: 36px; height: 36px; margin-right: var(--mf-space-2); flex-shrink: 0; background-color: var(--mf-color-field); border-radius: var(--mf-radius-sm); -unity-background-scale-mode: scale-to-fit; }
.panel-row-texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; justify-content: center; }
.panel-row-texts > Label { margin: 0; padding: 0; }
.panel-row-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.panel-row-detail { font-size: 10px; color: var(--mf-color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.favorite-button { width: 26px; height: 26px; color: var(--mf-color-border); }
.favorite-on, .favorite-on:hover { color: var(--mf-color-accent); }
.dlc-mark-button { width: 26px; height: 26px; color: var(--mf-color-border); }
.dlc-mark-on, .dlc-mark-on:hover { color: var(--mf-color-warning); }
.panel-info { margin-top: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.panel-info-warning { color: var(--mf-color-warning); }
.panel-toggle { margin: 0 0 var(--mf-space-2); }
.road-panel { position: absolute; left: 296px; bottom: 0; width: 360px; height: 360px; }
.road-profile { margin-bottom: var(--mf-space-2); -unity-font: url("Fonts/Inter-SemiBold.ttf"); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.road-fields { flex-direction: row; justify-content: space-between; margin-top: var(--mf-space-1); }
.road-field { flex-direction: column; width: 31%; margin: 0; }
.road-field > Label { min-width: 0; margin-bottom: 2px; font-size: 10px; color: var(--mf-color-text-secondary); }
.road-field .unity-base-text-field__input { height: 26px; padding-left: 6px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.road-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.road-field:disabled { opacity: 0.45; }
.panel-toggle > Label { min-width: 0; color: var(--mf-color-text-secondary); font-size: var(--mf-font-secondary); }
.panel-toggle .unity-toggle__checkmark { border-color: var(--mf-color-border); background-color: var(--mf-color-field); border-radius: var(--mf-radius-sm); }
.panel-row-tag { margin: 0 var(--mf-space-1); padding: 0 5px; font-size: 10px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); background-color: var(--mf-color-warning); border-radius: var(--mf-radius-sm); flex-shrink: 0; }

/* Project browser */
.panel-heading { margin-bottom: var(--mf-space-3); font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.browser-project-name { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-secondary); color: var(--mf-color-info); white-space: normal; }
.browser-map-name { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); white-space: normal; }
.browser-map-counts { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-map-warnings { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-warning); white-space: normal; }
.browser-map-description { margin-bottom: var(--mf-space-2); }
.browser-map-description Label { font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-lines { margin-bottom: var(--mf-space-2); flex-shrink: 0; }
.browser-line-list { max-height: 180px; }
.browser-chrono { margin-bottom: var(--mf-space-2); flex-shrink: 0; }
.browser-chrono-state { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-chrono-row { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.browser-chrono-date { flex-grow: 1; flex-shrink: 1; min-width: 80px; height: 28px; margin: 0 6px 0 0; }
.browser-chrono-date .unity-base-text-field__input { height: 28px; margin: 0; padding: 0 6px; font-size: var(--mf-font-secondary); -unity-text-align: middle-left; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.browser-chrono-date .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.browser-chrono-row > .map-control-button { flex-shrink: 0; padding-left: 8px; padding-right: 8px; }
.browser-chrono-row > .map-control-button:last-child { margin-right: 0; }
.browser-chrono-variant { white-space: normal; padding-top: 4px; padding-bottom: 4px; }
.browser-tile-list { flex-grow: 1; min-height: 0; }
.browser-tile-entry { min-height: 28px; margin: 0 0 3px; padding-left: var(--mf-space-2); padding-right: var(--mf-space-1); -unity-text-align: middle-left; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border-subtle); border-radius: var(--mf-radius-sm); }
.browser-tile-entry:hover { background-color: var(--mf-color-panel-hover); }
.browser-tile-entry-selected { border-color: var(--mf-color-accent); background-color: var(--mf-color-panel-hover); }
.browser-tile-entry-missing { color: var(--mf-color-error); }
.browser-tile-entry-edited { border-left-width: 3px; border-left-color: var(--mf-color-warning); }

/* Inspector */
.inspector-title { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.inspector-property { margin-bottom: 6px; }
.inspector-property-name { margin-bottom: 1px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.inspector-property-value { color: var(--mf-color-text-primary); white-space: normal; }
.inspector-records { flex-grow: 1; min-height: 0; margin-top: var(--mf-space-2); border-top-width: 1px; border-top-color: var(--mf-color-border-subtle); }
.inspector-section-heading { margin-top: var(--mf-space-3); margin-bottom: 5px; font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.inspector-record { margin-bottom: 4px; padding: 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-radius: var(--mf-radius-sm); white-space: normal; }
.inspector-record-empty { margin-bottom: 5px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-muted); }
.inspector-record-clickable:hover { background-color: var(--mf-color-panel-hover); }
.inspector-record-selected { background-color: var(--mf-color-panel-hover); border-left-width: 3px; border-left-color: var(--mf-color-accent); }
.inspector-edit { margin-top: var(--mf-space-2); padding: var(--mf-space-2); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); }
.inspector-edit-name { margin-bottom: 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); white-space: normal; }
.inspector-edit-field { margin: 2px 0; }
.inspector-edit-field > Label { min-width: 84px; width: 84px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.inspector-edit-apply { margin-top: 6px; align-self: flex-start; }
.inspector-edit-revert { margin-top: 6px; align-self: flex-start; }
.inspector-edit-delete { margin-top: 6px; align-self: flex-start; color: var(--mf-color-error); }
.inspector-edit-hint { margin-top: 6px; font-size: var(--mf-font-secondary); }
.muted { color: var(--mf-color-text-muted); white-space: normal; }

/* Scroll bars: a thin dark track without arrow buttons */
.unity-scroller--vertical { width: 8px; margin-left: var(--mf-space-1); border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { width: 8px; left: 0; border-width: 0; border-radius: var(--mf-radius-sm); background-color: var(--mf-color-panel); }
.unity-scroller--vertical .unity-base-slider__dragger { width: 8px; left: 0; border-width: 0; border-radius: var(--mf-radius-sm); background-color: var(--mf-color-border); }
.unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--mf-color-text-muted); }
.unity-scroller--vertical > .unity-scroller__slider { margin: 0; top: 0; bottom: 0; }

/* Foldouts */
.unity-foldout__toggle { margin-left: 0; }
.unity-foldout__text { color: var(--mf-color-text-secondary); font-size: var(--mf-font-secondary); }
.unity-foldout__checkmark { -unity-background-image-tint-color: var(--mf-color-text-secondary); }
.unity-foldout__content { margin-left: 15px; }

/* Buttons and fields shared by panels and dialogs */
.map-control-button { height: 28px; margin-right: 6px; padding-left: 10px; padding-right: 10px; color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.map-control-button:hover { background-color: var(--mf-color-panel-hover); }
.inspector-edit-field .unity-base-text-field__input, .dialog-field .unity-base-text-field__input { background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.inspector-edit-field .unity-base-text-field__input:focus, .dialog-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }

/* Dialogs */
.dialog-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(10, 12, 15, 0.7); }
.dialog { width: 560px; padding: var(--mf-space-4); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.dialog-field { margin: 4px 8px; }
.dialog-field > Label { min-width: 110px; width: 110px; color: var(--mf-color-text-secondary); }
.export-target { margin-top: 8px; color: var(--mf-color-info); }
.export-problem { color: var(--mf-color-error); }
.dialog-buttons { flex-direction: row; justify-content: flex-end; margin-top: var(--mf-space-3); }
.dialog-primary { background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); color: var(--mf-color-bg); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.dialog-primary:hover { background-color: var(--mf-color-accent-hover); }

/* Status bar */
.status-bar { height: 24px; min-height: 24px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: var(--mf-space-3); padding-right: var(--mf-space-3); background-color: var(--mf-color-panel); border-top-width: 1px; border-top-color: var(--mf-color-border-subtle); color: var(--mf-color-text-secondary); font-size: var(--mf-font-secondary); }
.status-bar > Label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-pointer { width: 360px; flex-shrink: 0; }
.status-selection { width: 130px; flex-shrink: 0; color: var(--mf-color-accent); }
.status-message { flex-grow: 1; flex-shrink: 1; color: var(--mf-color-text-primary); }
.status-map-state { flex-shrink: 0; margin-left: var(--mf-space-3); }
