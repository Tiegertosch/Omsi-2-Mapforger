/* Design tokens from Documentation/CorporateDesign.md; components use these instead of raw values. The fonts are
   Inter Regular and SemiBold in Fonts/, referenced directly because variables do not carry asset references. */
:root {
    --mf-color-bg: #171C23;
    --mf-color-panel: #202630;
    --mf-color-panel-glass: rgba(32, 38, 48, 0.94);
    --mf-color-bar-glass: rgba(23, 28, 35, 0.5);
    --mf-color-scrim: rgba(23, 28, 35, 0.85);
    --mf-color-panel-raised: #29313D;
    --mf-color-panel-hover: #35475A;
    --mf-color-field: #141920;
    --mf-color-border: #414B59;
    --mf-color-border-subtle: #2E3642;
    --mf-color-text-primary: #F2F4F7;
    --mf-color-text-secondary: #AEB8C5;
    --mf-color-text-muted: #7E8A99;
    --mf-color-accent: #F08A32;
    --mf-color-accent-hover: #FF9B45;
    --mf-color-selection: rgba(240, 138, 50, 0.4);
    --mf-color-success: #55B887;
    --mf-color-warning: #E6B450;
    --mf-color-error: #E06464;
    --mf-color-info: #65A9D9;

    /* Surfaces of the road builder's lane bar (ADR 049) */
    --mf-color-lane-asphalt: #3B4048;
    --mf-color-lane-shoulder: #4A505A;
    --mf-color-lane-walk: #8C9199;
    --mf-color-lane-grass: #4F7A3A;
    --mf-color-lane-bus: #6A4B3A;
    --mf-color-lane-bike: #7A3E3E;
    --mf-color-lane-parking: #44494F;
    --mf-color-lane-rail: #A9ADB3;

    --mf-space-1: 4px;
    --mf-space-2: 8px;
    --mf-space-3: 12px;
    --mf-space-4: 16px;

    --mf-radius-sm: 4px;
    --mf-radius-md: 6px;
    --mf-radius-lg: 8px;

    --mf-font-heading: 14px;
    --mf-font-body: 13px;
    --mf-font-secondary: 11px;
}

/* Application frame */
.app-root { width: 100%; height: 100%; min-height: 100%; flex-grow: 1; align-items: stretch; background-color: rgba(0, 0, 0, 0); color: var(--mf-color-text-primary); font-size: var(--mf-font-body); -unity-font: url("Fonts/Inter-Regular.ttf"); }
.menu-bar { height: 36px; min-height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: var(--mf-space-4); padding-right: var(--mf-space-4); background-color: var(--mf-color-panel); border-bottom-width: 1px; border-bottom-color: var(--mf-color-border-subtle); }
.brand { -unity-font: url("Fonts/Inter-SemiBold.ttf"); font-size: var(--mf-font-heading); }
.menu-container { margin-left: 24px; flex-direction: row; align-items: center; position: relative; }
.toolbar-menu-button { min-width: 50px; height: 28px; margin: 0 2px; padding-left: 10px; padding-right: 10px; color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.toolbar-menu-button:hover { background-color: var(--mf-color-panel-hover); }
.toolbar-menu-button:disabled { color: var(--mf-color-text-muted); }
.menu-bar-map { flex-grow: 1; -unity-text-align: middle-right; color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Menus and popups */
.menu-popup { position: absolute; top: 38px; min-width: 230px; padding: var(--mf-space-2); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); display: none; }
.file-menu { left: 168px; }
.edit-menu { left: 222px; }
.view-menu { left: 276px; }
.help-menu { left: 384px; width: 360px; }
.menu-popup-item { height: 32px; -unity-text-align: middle-left; padding-left: 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); color: var(--mf-color-text-primary); }
.menu-popup-item:hover { background-color: var(--mf-color-panel-hover); }
.menu-popup-item:disabled { color: var(--mf-color-text-muted); }
.menu-popup-item-checked { color: var(--mf-color-accent); }
.menu-divider { height: 1px; margin: 5px 4px; background-color: var(--mf-color-border); }
.menu-section-label { margin: 4px 10px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.popup-title { margin: 4px 8px 8px; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.popup-description { margin: 4px 8px; color: var(--mf-color-text-secondary); white-space: normal; }
.help-controls { margin-bottom: var(--mf-space-2); padding: var(--mf-space-2); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-sm); }
.popup-close { align-self: flex-end; min-width: 68px; -unity-text-align: middle-center; }

/* Workspace: the map fills it, panels and controls float above it */
.workspace { flex-grow: 1; min-height: 0; position: relative; overflow: hidden; background-color: rgba(0, 0, 0, 0); }
.map-view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; background-color: rgba(0, 0, 0, 0); }
.map-canvas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; --map-tile: var(--mf-color-panel); --map-tile-border: var(--mf-color-border); --map-tile-missing: var(--mf-color-error); --map-tile-selected: var(--mf-color-warning); --map-spline: var(--mf-color-accent); --map-object: var(--mf-color-info); --map-tree: var(--mf-color-success); --map-selection: var(--mf-color-error); --map-placement: var(--mf-color-success); --map-handle: var(--mf-color-panel-raised); --map-wire: var(--mf-color-text-secondary); --map-fence: var(--mf-color-text-muted); --map-route: var(--mf-color-text-primary); --map-route-quiet: var(--mf-color-text-secondary); }
.map-angle-label { position: absolute; padding: 2px 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-glass); border-radius: var(--mf-radius-sm); }
.empty-state { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
/* Welcome screen in the middle of the empty map */
.welcome { width: 720px; align-items: stretch; }
.welcome-title { font-size: 26px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); -unity-text-align: middle-center; }
.welcome-tagline { margin-top: var(--mf-space-1); margin-bottom: 28px; -unity-text-align: middle-center; color: var(--mf-color-text-secondary); }
.welcome-cards { flex-direction: row; justify-content: space-between; margin-bottom: 28px; }
.welcome-card { width: 228px; height: 168px; margin: 0; padding: var(--mf-space-4); flex-direction: column; align-items: flex-start; justify-content: flex-start; color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.welcome-card:hover { border-color: var(--mf-color-accent); background-color: var(--mf-color-panel-raised); }
.welcome-card:disabled { color: var(--mf-color-text-muted); }
.welcome-card-icon { width: 40px; height: 40px; margin-bottom: var(--mf-space-3); padding: 9px; color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-radius: var(--mf-radius-md); }
.welcome-card:disabled .welcome-card-icon { color: var(--mf-color-text-muted); background-color: var(--mf-color-panel-raised); }
.welcome-card-icon > .icon { flex-grow: 1; }
.welcome-card-title { margin: 0 0 var(--mf-space-1); padding: 0; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.welcome-card-text { margin: 0; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; -unity-text-align: upper-left; }
.welcome-card:disabled .welcome-card-text { color: var(--mf-color-text-muted); }
.welcome-card-badge { position: absolute; top: var(--mf-space-4); right: var(--mf-space-4); padding: 1px 6px; font-size: 10px; color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel-raised); border-radius: var(--mf-radius-sm); }
.welcome-section { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.welcome-recent { padding: var(--mf-space-1); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.welcome-empty { padding: var(--mf-space-3); color: var(--mf-color-text-muted); }
.welcome-recent-row { height: 46px; margin: 0; padding: 0 var(--mf-space-3); flex-direction: row; align-items: center; color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-md); }
.welcome-recent-row:hover { background-color: var(--mf-color-panel-hover); }
.welcome-recent-row:disabled { color: var(--mf-color-text-muted); }
.welcome-recent-icon { width: 18px; height: 18px; margin-right: var(--mf-space-3); color: var(--mf-color-accent); flex-shrink: 0; }
.welcome-recent-row:disabled .welcome-recent-icon { color: var(--mf-color-text-muted); }
.welcome-recent-texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.welcome-recent-texts > Label { margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.welcome-recent-name { -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.welcome-recent-path { font-size: 10px; color: var(--mf-color-text-muted); }
.welcome-recent-kind { margin: 0 0 0 var(--mf-space-3); padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); flex-shrink: 0; }
.primary-button { margin-top: 20px; height: 36px; padding-left: var(--mf-space-4); padding-right: var(--mf-space-4); background-color: var(--mf-color-accent); color: var(--mf-color-bg); -unity-font: url("Fonts/Inter-SemiBold.ttf"); border-width: 0; border-radius: var(--mf-radius-md); }
.primary-button:hover { background-color: var(--mf-color-accent-hover); }

/* Floating panels */
.floating-panel { position: absolute; top: var(--mf-space-2); bottom: var(--mf-space-2); padding: var(--mf-space-3); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
/* The inspector opens on demand (right-click, Properties...) and leaves room for the bottom bar. */
.inspector-frame { right: var(--mf-space-2); bottom: 106px; width: 300px; }
/* The popups of the bottom bar (tiles, map, entries, chrono, lines, paths) open above the bar, at its left or right end (ADR 098). */
.bar-popup { top: auto; bottom: 106px; left: var(--mf-space-2); width: 320px; max-height: 70%; }
.bar-popup-right { left: auto; right: var(--mf-space-2); }
.bar-popup-tall { height: 480px; }
.bar-popup > .floating-panel-header { margin: -12px -12px var(--mf-space-2) -12px; padding: var(--mf-space-2) var(--mf-space-2) var(--mf-space-2) var(--mf-space-3); background-color: var(--mf-color-bg); border-bottom-width: 1px; border-bottom-color: var(--mf-color-border-subtle); border-top-left-radius: var(--mf-radius-lg); border-top-right-radius: var(--mf-radius-lg); }
.floating-panel-header { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: var(--mf-space-2); }
.floating-panel-title { flex-grow: 1; font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.floating-panel-icon { width: 18px; height: 18px; margin-right: var(--mf-space-2); color: var(--mf-color-accent); }
.floating-panel-content { flex-grow: 1; min-height: 0; }
.panel-collapse-button { width: 24px; height: 24px; margin: 0; padding: 3px; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-collapse-button > .icon { flex-grow: 1; }
.panel-collapse-button:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.floating-panel-collapsed { bottom: auto; width: auto; padding-top: var(--mf-space-1); padding-bottom: var(--mf-space-1); }
.floating-panel-collapsed > .floating-panel-header { margin-bottom: 0; }
.floating-panel-collapsed .floating-panel-title { margin-right: var(--mf-space-2); }
.floating-panel-collapsed > .floating-panel-content { display: none; }

/* Tooltips (ADR 098, stage 2): a dark card above the element, an upper-case title with its key, then the text, as in the references. */
.shell-tooltip { position: absolute; max-width: 360px; padding: var(--mf-space-2) var(--mf-space-3); background-color: var(--mf-color-bg); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.shell-tooltip-heading { flex-direction: row; align-items: center; }
.shell-tooltip-title { flex-shrink: 1; margin: 0 0 2px 0; padding: 0; font-size: var(--mf-font-body); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-primary); white-space: normal; }
.shell-tooltip-key { margin: 0 0 2px var(--mf-space-2); padding: 0 5px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.shell-tooltip-text { margin: 0; padding: 0; font-size: var(--mf-font-body); color: var(--mf-color-text-primary); white-space: normal; }

/* The bottom bar (ADR 098): view and zoom at the left, the tile button and the project name, the tools in the middle, the map's
   lists as round buttons at the right. The status bar runs below it. */
.bottom-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 94px; flex-direction: row; align-items: stretch; background-color: var(--mf-color-bar-glass); border-top-width: 1px; border-top-color: rgba(65, 75, 89, 0.6); }
.bottom-bar-empty { height: 34px; }
.bar-main { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: flex-end; }
.bar-row { flex-direction: row; align-items: center; height: 54px; flex-shrink: 0; padding: 0 var(--mf-space-3) 0 var(--mf-space-2); }
.bar-group { flex-direction: row; align-items: center; flex-shrink: 0; }
/* The tile button: the icon alone, with the number of tiles on it */
.bar-tile-button { width: 42px; height: 42px; margin: 0 3px 0 0; padding: 8px; color: var(--mf-color-success); background-color: rgba(32, 38, 48, 0.62); border-width: 1px; border-color: rgba(65, 75, 89, 0.7); border-radius: 21px; }
.bar-tile-button > .icon { flex-grow: 1; }
.bar-tile-button:hover { background-color: var(--mf-color-panel-hover); border-color: var(--mf-color-border); }
.bar-tile-button:disabled { color: var(--mf-color-text-muted); }
.bar-tile-button.bar-button-active, .bar-tile-button.bar-button-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); }
/* The round buttons at the right end, dark like the icons of the Cities: Skylines bar */
.bar-round-button { width: 38px; height: 38px; margin: 0 4px; padding: 9px; color: var(--mf-color-text-primary); background-color: rgba(32, 38, 48, 0.62); border-width: 1px; border-color: rgba(65, 75, 89, 0.7); border-radius: 19px; }
.bar-round-button > .icon { flex-grow: 1; }
.bar-round-button:hover { background-color: var(--mf-color-panel-hover); border-color: var(--mf-color-border); }
.bar-round-button:disabled { color: var(--mf-color-text-muted); }
.bar-round-button.bar-button-active, .bar-round-button.bar-button-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); }
.bar-badge { position: absolute; top: -2px; right: -4px; min-width: 18px; height: 18px; padding: 0 5px; font-size: 10px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); -unity-text-align: middle-center; color: var(--mf-color-bg); background-color: var(--mf-color-success); border-radius: 9px; }
/* The project name: a wide dark pill with the name in the middle */
.bar-pill { flex-basis: 240px; flex-grow: 0; height: 30px; margin: 0 var(--mf-space-3) 0 var(--mf-space-1); flex-shrink: 1000; min-width: 70px; flex-direction: row; align-items: center; justify-content: center; color: var(--mf-color-text-primary); background-color: rgba(20, 25, 32, 0.7); border-width: 1px; border-color: var(--mf-color-border-subtle); border-radius: 15px; overflow: hidden; }
.bar-pill > Label { margin: 0; padding: 0 12px; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-center; -unity-font: url("Fonts/Inter-SemiBold.ttf"); }

/* Mode badge inside the project pill: grey for read-only and a chrono date, yellow while a variant is edited */
.bar-pill-with-mode > Label { padding-right: 6px; }
.bar-mode { flex-direction: row; align-items: center; flex-shrink: 0; max-width: 120px; height: 18px; margin: 0 8px 0 0; padding: 0 7px 0 6px; border-width: 1px; border-color: var(--mf-color-text-muted); border-radius: 9px; overflow: hidden; }
.bar-mode-dot { flex-shrink: 0; width: 6px; height: 6px; margin-right: 5px; border-radius: 3px; background-color: var(--mf-color-text-muted); }
.bar-mode-text { margin: 0; padding: 0; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; color: var(--mf-color-text-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.bar-mode-variant { border-color: var(--mf-color-warning); }
.bar-mode-variant > .bar-mode-dot { background-color: var(--mf-color-warning); }
.bar-mode-variant > .bar-mode-text { color: var(--mf-color-warning); }

/* Compact bar for windows narrower than 1400 px */
.bar-compact .bar-pill { flex-basis: 110px; min-width: 60px; margin-right: var(--mf-space-1); }
.bar-compact .bar-mode { padding: 0 5px; }
.bar-compact .bar-mode-dot { margin-right: 0; }
.bar-compact .bar-mode-text { display: none; }
.bar-compact .bar-round-button { width: 32px; height: 32px; margin: 0 3px; padding: 7px; border-radius: 16px; }
.bar-compact .view-controls { width: 180px; padding: 4px 6px; }
.bar-compact .view-controls-row > .view-control-button { padding-left: 4px; padding-right: 4px; }
.bar-compact .bar-row { padding-right: var(--mf-space-1); }
.bar-compact .tool-button { flex-basis: 32px; min-width: 26px; height: 32px; margin: 0 2px; border-radius: 16px; }
.bar-compact .tool-icon { width: 18px; height: 18px; }

/* View controls: three short rows at the left end of the bottom bar */
.view-controls { flex-direction: column; justify-content: center; align-items: stretch; flex-shrink: 0; width: 192px; margin: 0; padding: 4px 8px; background-color: rgba(32, 38, 48, 0.62); border-right-width: 1px; border-right-color: rgba(65, 75, 89, 0.6); border-top-right-radius: var(--mf-radius-lg); }
.view-controls-row { flex-direction: row; align-items: center; }
.view-controls-row > .view-control-button { flex-grow: 1; height: 24px; margin: 1px; font-size: 11px; justify-content: center; }
.view-control-button { height: 28px; margin: 0 2px; padding-left: var(--mf-space-2); padding-right: var(--mf-space-2); color: var(--mf-color-text-primary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.view-control-button:hover { background-color: var(--mf-color-panel-hover); }
.view-control-button:disabled { color: var(--mf-color-text-muted); }
.view-control-button { flex-direction: row; align-items: center; }
.view-control-button > .icon { width: 16px; height: 16px; margin-right: 6px; }
.view-control-button > Label { margin: 0; padding: 0; }
.view-control-icon-only { width: 30px; padding-left: 0; padding-right: 0; justify-content: center; }
.view-controls-row > .view-control-icon-only { flex-grow: 0; width: 26px; }
.view-control-icon-only > .icon { margin-right: 0; }
.view-control-active, .view-control-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); }
.view-control-active:disabled { color: var(--mf-color-bg); background-color: var(--mf-color-accent); opacity: 0.5; }
.view-control-separator { width: 1px; height: 18px; margin: 0 var(--mf-space-1); background-color: var(--mf-color-border); }
.zoom-label { min-width: 52px; -unity-text-align: middle-center; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }

/* Tool bar in the middle of the bottom bar: the icons alone, as in the sketch; name and key stand in the tooltip */
.tool-bar-host { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: row; justify-content: center; overflow: hidden; }
.tool-bar { flex-direction: row; align-items: stretch; flex-shrink: 1; min-width: 0; padding: 0 4px; }
.tool-group { flex-direction: row; flex-shrink: 1; min-width: 0; }
.tool-separator { width: 1px; flex-shrink: 0; margin: 12px 8px; background-color: rgba(65, 75, 89, 0.8); }
/* In a narrow window the buttons give up width down to 34 px before the bar clips. */
.tool-button { flex-basis: 40px; flex-shrink: 1; min-width: 28px; height: 40px; margin: 0 4px; padding: 0; flex-direction: column; align-items: center; justify-content: center; color: var(--mf-color-text-primary); background-color: rgba(32, 38, 48, 0.62); border-width: 1px; border-color: rgba(65, 75, 89, 0.7); border-radius: 20px; }
.tool-button:hover { background-color: var(--mf-color-panel-hover); border-color: var(--mf-color-border); }
.tool-button:disabled { color: var(--mf-color-text-muted); }
.tool-button-active, .tool-button-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); }
.tool-icon { width: 22px; height: 22px; flex-shrink: 0; }
.tool-label { display: none; }
.tool-keycap { display: none; }

/* Context menu on a right-click in the map (ADR 098): an overlay catches the click outside, the menu stands at the pointer */
.context-menu-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.context-menu { position: absolute; min-width: 220px; padding: var(--mf-space-2); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); }
.context-menu-header { margin: 2px 10px 6px; font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.context-menu-item { flex-direction: row; align-items: center; padding-right: 10px; }
.context-menu-item > Label { margin: 0; padding: 0; }
.context-menu-text { flex-grow: 1; -unity-text-align: middle-left; }
.context-menu-key { margin-left: var(--mf-space-3); font-size: 10px; color: var(--mf-color-text-muted); }
.context-menu-danger { color: var(--mf-color-error); }

/* Tool panels open above the bottom bar */
.tool-panel-host { position: absolute; left: 0; right: 0; bottom: 104px; flex-direction: row; justify-content: center; }
.tool-panel { width: 420px; height: 470px; padding: var(--mf-space-3); background-color: var(--mf-color-panel-glass); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.tool-panel-header { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-3); }
.tool-panel-badge { width: 40px; height: 40px; margin-right: var(--mf-space-3); align-items: center; justify-content: center; color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-radius: var(--mf-radius-md); }
.tool-panel-badge > .icon { width: 24px; height: 24px; }
.tool-panel-titles { flex-grow: 1; }
.tool-panel-title { font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.tool-panel-subtitle { font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.panel-icon-button { width: 28px; height: 28px; margin: 0; padding: 4px; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-icon-button:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.panel-icon-button > .icon { flex-grow: 1; }
.panel-tabs { flex-direction: row; margin-bottom: var(--mf-space-2); padding: 3px; background-color: var(--mf-color-field); border-radius: var(--mf-radius-md); }
.panel-tab { flex-grow: 1; height: 30px; margin: 0; color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); }
.panel-tab:hover { color: var(--mf-color-text-primary); }
.panel-tab-active, .panel-tab-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.panel-search { margin-bottom: var(--mf-space-2); }
.panel-search-field { margin: 0; }
.panel-search-field .unity-base-text-field__input { height: 32px; padding-left: var(--mf-space-2); padding-right: 30px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.panel-search-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.panel-search-icon { position: absolute; right: 8px; top: 8px; width: 16px; height: 16px; color: var(--mf-color-text-secondary); }
.panel-folder-bar { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.panel-folder-label { flex-grow: 1; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.panel-list { flex-grow: 1; min-height: 0; }
.panel-list .unity-collection-view__item { background-color: rgba(0, 0, 0, 0); border-radius: var(--mf-radius-sm); }
.panel-list .unity-collection-view__item:hover { background-color: var(--mf-color-panel-hover); }
.panel-list .unity-collection-view__item--selected { background-color: var(--mf-color-panel-hover); border-left-width: 3px; border-left-color: var(--mf-color-accent); }
.panel-row { flex-grow: 1; flex-direction: row; align-items: center; padding-left: var(--mf-space-1); padding-right: var(--mf-space-1); }
.panel-row-icon { width: 18px; height: 18px; margin-right: var(--mf-space-2); color: var(--mf-color-text-secondary); flex-shrink: 0; }
.dialog-row { flex-direction: row; align-items: center; margin: 4px 0; }
.check-dialog { width: 760px; max-height: 86%; }
.check-sections { flex-shrink: 1; min-height: 120px; max-height: 560px; margin: 4px 0 8px; }
.check-section { margin: 0 0 var(--mf-space-2); padding: var(--mf-space-2) var(--mf-space-3); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-md); }
.check-section-header { flex-direction: row; align-items: center; }
.check-section-title { flex-grow: 1; margin: 0; -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.check-status { margin: 0 var(--mf-space-2) 0 0; padding: 1px 6px; font-size: 10px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); border-radius: var(--mf-radius-sm); }
.check-status-passed { background-color: var(--mf-color-success); }
.check-status-note { background-color: var(--mf-color-warning); }
.check-status-problem { background-color: var(--mf-color-error); }
.check-section-summary { margin: 2px 0 0; white-space: normal; color: var(--mf-color-text-secondary); }
.check-finding { margin: 1px 0 0 var(--mf-space-3); font-size: var(--mf-font-secondary); white-space: normal; color: var(--mf-color-text-secondary); }
.check-section-button { height: 24px; margin: 0 0 0 var(--mf-space-2); }
.check-more-button { align-self: flex-start; height: 22px; margin: 2px 0 0 var(--mf-space-3); font-size: var(--mf-font-secondary); }
.dialog-row-text { flex-grow: 1; flex-shrink: 1; margin: 0 8px; }
.panel-row-thumbnail { width: 36px; height: 36px; margin-right: var(--mf-space-2); flex-shrink: 0; background-color: var(--mf-color-field); border-radius: var(--mf-radius-sm); -unity-background-scale-mode: scale-to-fit; }
.panel-row-texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; justify-content: center; }
.panel-row-texts > Label { margin: 0; padding: 0; }
.panel-row-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.panel-row-detail { font-size: 10px; color: var(--mf-color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.favorite-button { width: 26px; height: 26px; color: var(--mf-color-border); }
.favorite-on, .favorite-on:hover { color: var(--mf-color-accent); }
.folders-left-out, .folders-left-out:hover { color: var(--mf-color-warning); }
.picker-options.signal-options { width: 380px; min-width: 380px; max-width: 380px; }
.signal-movements { max-height: 230px; flex-shrink: 1; }
.signal-group-row, .signal-movement-row { flex-direction: row; align-items: center; margin: 2px 0; }
.signal-group-chip { width: 12px; height: 12px; border-radius: 3px; margin: 0 6px 0 2px; flex-shrink: 0; }
.picker-field.signal-group-name { flex-grow: 1; flex-shrink: 1; width: auto; margin: 0 4px 0 0; }
.signal-group-count { color: var(--mf-color-text-muted); margin-right: 2px; font-size: var(--mf-font-secondary); }
.signal-approach { color: var(--mf-color-text-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); margin: 6px 0 2px; }
.signal-movement-row { padding: 1px 2px; border-radius: var(--mf-radius-sm); }
.signal-movement-row:hover { background-color: var(--mf-color-panel-hover); }
.signal-movement-selected { background-color: var(--mf-color-panel-hover); }
.signal-movement-text { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); margin-right: 4px; }
.signal-movement-group { width: 118px; margin: 0; flex-shrink: 0; }
.signal-movement-group .unity-base-popup-field__input { height: 24px; margin: 0; padding: 0 6px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.signal-movement-group .unity-base-popup-field__input:hover { border-color: var(--mf-color-accent); }
.signal-movement-group .unity-base-popup-field__text { color: var(--mf-color-text-primary); }
.signal-timeline { margin: 4px 0; }
.signal-scroll-page { max-height: 520px; flex-shrink: 1; }
.signal-matrix-scroll { max-height: 260px; margin: 2px 0 4px; }
.signal-matrix { flex-direction: column; }
.signal-matrix-row { flex-direction: row; }
.signal-matrix-head { width: 22px; min-width: 22px; height: 20px; margin: 1px; padding: 0; -unity-text-align: middle-center; font-size: 10px; color: var(--mf-color-text-secondary); border-bottom-width: 3px; border-color: rgba(0, 0, 0, 0); }
.signal-matrix-cell { width: 22px; min-width: 22px; height: 20px; margin: 1px; padding: 0; font-size: 10px; color: #ffffff; -unity-font: url("Fonts/Inter-SemiBold.ttf"); border-width: 0; border-radius: 3px; }
.signal-matrix-cell:hover { border-width: 1px; border-color: #ffffff; }
.signal-matrix-cell:disabled { opacity: 1; }
.signal-matrix-self { background-color: rgba(0, 0, 0, 0.35); }
.signal-matrix-manual { border-width: 2px; border-color: #ffffff; }
.signal-matrix-swatch { width: 12px; height: 12px; border-radius: 3px; margin: 0 4px 0 0; }
.signal-finding { margin: 1px 0; padding-left: 6px; font-size: var(--mf-font-secondary); white-space: normal; border-left-width: 3px; }
.signal-finding-error { color: var(--mf-color-text-primary); border-left-color: #c84040; }
.signal-finding-warning { color: var(--mf-color-text-primary); border-left-color: #d9a92e; }
.signal-finding-hint { color: var(--mf-color-text-secondary); border-left-color: var(--mf-color-border); }
.signal-preview { margin: 4px 0; padding: 4px; border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.signal-preview-button { width: 28px; min-width: 28px; height: 24px; margin: 0 3px 0 0; padding: 4px; }
.signal-preview-button > .icon { flex-grow: 1; }
.picker-field.signal-preview-time { width: 64px; min-width: 64px; margin: 0 3px 0 0; }
.signal-movement-group.signal-preview-speed { width: 62px; }
.signal-window { margin: 1px 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.signal-phase { margin: 4px 0; padding: 4px 6px; border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.signal-phase-title { flex-grow: 1; color: var(--mf-color-text-primary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); margin: 0; }
.signal-phase-groups { flex-direction: row; flex-wrap: wrap; margin-top: 2px; }
.signal-phase-chip { margin: 2px 4px 2px 0; padding: 2px 8px; height: 22px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-muted); background-color: rgba(0, 0, 0, 0); border-width: 1px 1px 1px 4px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.signal-phase-chip:hover { border-color: var(--mf-color-text-secondary); }
.signal-phase-chip.signal-phase-chip-on { color: var(--mf-color-text-primary); background-color: var(--mf-color-field); border-top-color: var(--mf-color-text-secondary); border-right-color: var(--mf-color-text-secondary); border-bottom-color: var(--mf-color-text-secondary); }
.signal-plan-field { flex-direction: row; align-items: center; margin: 2px 8px 2px 0; }
.signal-plan-field > .signal-movement-text { margin-right: 4px; }
.signal-plan-field > .picker-field { width: 52px; min-width: 52px; }
.signal-head-type { margin: 2px 0; }
.signal-head-type .unity-base-popup-field__input { height: 24px; margin: 0; padding: 0 6px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.signal-head-type .unity-base-popup-field__text { color: var(--mf-color-text-primary); }
.signal-head-type > .unity-label, .signal-options .unity-text-field > .unity-label, .signal-options .unity-toggle > .unity-label { color: var(--mf-color-text-secondary); min-width: 110px; }
.signal-brush { width: 26px; height: 20px; margin: 0 4px 0 0; padding: 0; border-width: 2px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); overflow: hidden; }
.signal-brush:hover { border-color: var(--mf-color-text-secondary); }
.signal-brush.signal-brush-active { border-color: var(--mf-color-text-primary); }
.signal-brush-lower { position: absolute; left: 0; right: 0; bottom: 0; height: 50%; }
.signal-timeline-axis { flex-direction: row; height: 14px; }
.signal-timeline-scale { flex-grow: 1; position: relative; }
.signal-timeline-tick { position: absolute; top: 0; translate: -50% 0; margin: 0; padding: 0; font-size: 10px; color: var(--mf-color-text-muted); }
.signal-timeline-row { flex-direction: row; align-items: center; margin: 2px 0; }
.signal-timeline-name { width: 74px; min-width: 74px; margin: 0 4px 0 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); overflow: hidden; }
.signal-timeline-axis > .signal-timeline-name { width: 94px; min-width: 94px; }
.signal-timeline-bar { flex-grow: 1; border-radius: 2px; background-color: var(--mf-color-field); }
.signal-issues { white-space: normal; }
.signal-dirty { border-color: var(--mf-color-warning); border-width: 2px; }
.signal-shared-hint { margin: 0 0 4px 20px; color: var(--mf-color-text-muted); }
.content-folders { color: var(--mf-color-text-primary); max-height: 92%; }
.content-folders-toggle .unity-toggle__text { color: var(--mf-color-text-primary); margin-left: 6px; }
.content-folders-list { max-height: 420px; min-height: 120px; flex-shrink: 1; margin: var(--mf-space-2) 0; border-width: 1px; border-color: var(--mf-color-border-subtle); border-radius: var(--mf-radius-sm); padding: var(--mf-space-2); }
.content-folders-header { flex-direction: row; align-items: center; margin-top: var(--mf-space-2); }
.content-folders-heading { flex-grow: 1; margin: 0; }
.content-folders-small { height: 22px; padding: 0 8px; margin-left: 4px; }
.content-folders-toggle { margin: 1px 0 1px 8px; }
.content-folders-installation { color: var(--mf-color-text-muted); }
.content-folders-note { color: var(--mf-color-text-muted); }
.dlc-mark-button { width: 26px; height: 26px; color: var(--mf-color-border); }
.dlc-mark-on, .dlc-mark-on:hover { color: var(--mf-color-warning); }
.panel-info { margin-top: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.panel-info-warning { color: var(--mf-color-warning); }
.panel-toggle { margin: 0 0 var(--mf-space-2); }
/* Options column and catalog stand side by side with the same top and bottom edge; a tool without a catalog is not a picker-tool and keeps the height of its content. */
.picker-tool { flex-direction: row; align-items: stretch; }
.picker-options { width: 236px; min-width: 236px; max-width: 236px; height: auto; margin-right: var(--mf-space-2); flex-shrink: 0; flex-grow: 0; }
.picker-options-title { margin: 0 0 var(--mf-space-2); font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.picker-option { flex-direction: row; align-items: center; justify-content: space-between; min-height: 30px; margin-bottom: var(--mf-space-1); }
.picker-option:disabled { opacity: 0.45; }
.picker-option-label { flex-shrink: 0; margin: 0 var(--mf-space-2) 0 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.picker-segmented { flex-grow: 1; margin: 0; padding: 2px; }
.picker-segmented > .panel-tab { height: 24px; padding: 0 4px; font-size: 11px; }
.picker-option-toggle { margin: 0; }
.picker-field { width: 76px; height: 26px; margin: 0; flex-shrink: 0; }
.picker-field TextElement { margin: 0; padding: 0; font-size: 12px; }
.picker-field .unity-base-text-field__input { height: 26px; margin: 0; padding: 0 6px; -unity-text-align: middle-left; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.picker-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.picker-panel { width: 780px; min-width: 780px; max-width: 780px; height: 210px; padding: 0; flex-shrink: 0; flex-grow: 0; background-color: var(--mf-color-bar-glass); }
.picker-header { height: 44px; flex-shrink: 0; margin: 0; padding: 0 var(--mf-space-2); background-color: var(--mf-color-panel); border-top-left-radius: var(--mf-radius-lg); border-top-right-radius: var(--mf-radius-lg); }
.picker-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-subtitle { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-search { width: 210px; margin: 0 var(--mf-space-2); flex-shrink: 0; }
.picker-tabs { flex-shrink: 0; overflow: hidden; margin-bottom: 6px; padding: 2px; }
.picker-tab { flex-basis: 0; min-width: 0; padding: 0 4px; font-size: 11px; }
.picker-tiles { flex-grow: 1; min-height: 0; padding: var(--mf-space-2) var(--mf-space-1) 0 var(--mf-space-2); }
.picker-tiles-content { flex-direction: row; flex-wrap: wrap; }
.picker-tile { width: 70px; height: 70px; margin: 0 6px 8px 0; padding: 3px; align-items: center; background-color: var(--mf-color-panel); border-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: var(--mf-radius-md); }
.picker-tile:hover { background-color: var(--mf-color-panel-hover); }
.picker-tile-selected, .picker-tile-selected:hover { border-color: var(--mf-color-accent); }
.picker-tile-preview { width: 60px; height: 60px; background-color: var(--mf-color-field); border-radius: var(--mf-radius-sm); -unity-background-scale-mode: stretch-to-fill; }
.picker-tile-name { display: none; position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 2px 3px; font-size: 9px; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mf-color-text-primary); background-color: var(--mf-color-scrim); border-bottom-left-radius: var(--mf-radius-md); border-bottom-right-radius: var(--mf-radius-md); }
.picker-tile:hover > .picker-tile-name { display: flex; }
.picker-tile-count { position: absolute; left: 4px; top: 4px; padding: 0 4px; font-size: 9px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); background-color: var(--mf-color-accent); border-radius: var(--mf-radius-sm); }
.picker-tile-star { position: absolute; right: 2px; top: 2px; width: 18px; height: 18px; padding: 2px; }
.picker-tile-edit { position: absolute; right: 2px; top: 20px; width: 18px; height: 18px; padding: 3px; color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-sm); }
.picker-tile-edit:hover { color: var(--mf-color-accent); }
.picker-tile-tag { position: absolute; left: 4px; bottom: 4px; padding: 0 4px; font-size: 9px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); background-color: var(--mf-color-warning); border-radius: var(--mf-radius-sm); }
.picker-more { justify-content: center; white-space: normal; font-size: 11px; color: var(--mf-color-text-secondary); }
.object-tile-preview { align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; }
.object-tile-spinner { width: 24px; height: 24px; color: var(--mf-color-accent); }
.object-tile-icon { width: 22px; height: 22px; color: var(--mf-color-text-muted); }
.object-folder-preview { flex-direction: column; }
.object-folder-count { margin: 2px 0 0; font-size: 10px; color: var(--mf-color-text-secondary); }
/* The terrain tool's brushes as tiles with an icon (ADR 098, stage 2). */
.terrain-brush-icon { align-items: center; justify-content: center; color: var(--mf-color-text-primary); }
.terrain-brush-icon > .icon { width: 28px; height: 28px; }
.picker-tile-selected .terrain-brush-icon { color: var(--mf-color-accent); }
.terrain-page { padding: var(--mf-space-2); }
.picker-panel > .panel-folder-bar { margin: var(--mf-space-1) var(--mf-space-2) 0; }
/* The menus of the bar are at most 210 px tall, as in the references (ADR 098, stage 2): a flat header, flat tabs, two rows of small
   tiles that scroll, and option columns that scroll once they are taller. */
.picker-search .panel-search-field .unity-base-text-field__input { height: 26px; padding-top: 0; padding-bottom: 0; -unity-text-align: middle-left; }
.picker-search .panel-search-icon { top: 5px; }
.picker-header { flex-direction: row; align-items: center; }
.picker-header > .picker-tabs { flex-grow: 1; margin: 0 var(--mf-space-2) 0 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-radius: 0; }
.picker-icon-tab { flex-grow: 0; flex-basis: auto; width: 36px; height: 36px; margin: 0 2px 0 0; padding: 0; align-items: center; justify-content: center; border-radius: var(--mf-radius-md); }
.picker-icon-tab:hover { background-color: var(--mf-color-panel-hover); }
.picker-icon-tab > .icon { width: 22px; height: 22px; }
.picker-header > .picker-search { width: 200px; margin: 0 var(--mf-space-1) 0 0; }
.picker-search-open { color: var(--mf-color-accent); }
.status-message.status-warning { color: var(--mf-color-warning); }
.tool-options-scroll { max-height: 210px; padding: var(--mf-space-2) var(--mf-space-2) var(--mf-space-2) var(--mf-space-3); }
.tool-options-scroll .picker-option { min-height: 26px; margin-bottom: 2px; }
/* Option columns of icons (ADR 098, stage 2): rows of a short label and icons, all in view without scrolling. */
.icon-options { width: 312px; min-width: 312px; max-width: 312px; padding: var(--mf-space-2) var(--mf-space-2) var(--mf-space-1) var(--mf-space-3); }
.option-row { flex-direction: row; align-items: center; height: 30px; margin-bottom: 2px; }
.option-row:disabled { opacity: 0.45; }
.option-row-label { width: 64px; flex-shrink: 0; margin: 0; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.option-icons { flex-direction: row; margin: 0 2px 0 0; padding: 0; }
.option-icon { width: 28px; height: 28px; margin: 0 2px 0 0; padding: 0; align-items: center; justify-content: center; color: var(--mf-color-text-secondary); background-color: var(--mf-color-field); border-width: 0; border-radius: var(--mf-radius-md); }
.option-icon:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.option-icon.panel-tab-active, .option-icon.panel-tab-active:hover { color: var(--mf-color-bg); background-color: var(--mf-color-accent); }
/* Every icon of an option column is 16 x 16 px in a box of 28 x 28 px, whatever kind of control holds it. */
.option-icon > .icon, .option-switch .icon, .option-value-icon { flex-grow: 0; flex-shrink: 0; width: 16px; height: 16px; }
.option-switch { margin: 0 2px 0 0; padding: 0; }
.option-switch > .unity-toggle__input { width: 28px; height: 28px; padding: 0; align-items: center; justify-content: center; color: var(--mf-color-text-secondary); background-color: var(--mf-color-field); border-radius: var(--mf-radius-md); }
.option-switch > .unity-toggle__input > .unity-toggle__checkmark { display: none; }
.option-switch:hover > .unity-toggle__input { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.option-switch:checked > .unity-toggle__input { color: var(--mf-color-bg); background-color: var(--mf-color-accent); }
.option-switch:disabled { opacity: 0.45; }
.option-value { flex-direction: row; align-items: center; margin: 0 var(--mf-space-1) 0 0; }
.option-value:disabled { opacity: 0.45; }
.option-value-icon { margin-right: 3px; color: var(--mf-color-text-muted); }
.picker-field.option-value-field { width: 40px; min-width: 40px; height: 28px; }
.picker-field.option-value-field .unity-base-text-field__input { height: 28px; padding: 0 4px; }
.option-value-unit { margin: 0 0 0 2px; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-muted); }
.picker-empty { position: absolute; left: var(--mf-space-3); right: var(--mf-space-3); top: 80px; }
.panel-toggle > Label { min-width: 0; color: var(--mf-color-text-secondary); font-size: var(--mf-font-secondary); }
.panel-toggle .unity-toggle__checkmark { border-color: var(--mf-color-border); background-color: var(--mf-color-field); border-radius: var(--mf-radius-sm); }
.panel-row-tag { margin: 0 var(--mf-space-1); padding: 0 5px; font-size: 10px; -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-bg); background-color: var(--mf-color-warning); border-radius: var(--mf-radius-sm); flex-shrink: 0; }

/* Project popups (the former project browser) */
.panel-heading { margin-bottom: var(--mf-space-3); font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.browser-project-name { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-secondary); color: var(--mf-color-info); white-space: normal; }
.browser-map-name { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); white-space: normal; }
.browser-map-counts { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-map-warnings { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-warning); white-space: normal; }
.browser-map-description { margin-bottom: var(--mf-space-2); }
.browser-map-description Label { font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-lines { margin-bottom: var(--mf-space-2); flex-shrink: 0; }
.browser-line-list { max-height: 180px; }
.browser-chrono { margin-bottom: var(--mf-space-2); flex-shrink: 0; }
.browser-chrono-state { margin-bottom: var(--mf-space-1); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.browser-chrono-row { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.browser-chrono-date { flex-grow: 1; flex-shrink: 1; min-width: 80px; height: 28px; margin: 0 6px 0 0; }
.browser-chrono-date .unity-base-text-field__input { height: 28px; margin: 0; padding: 0 6px; font-size: var(--mf-font-secondary); -unity-text-align: middle-left; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.browser-chrono-date .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.browser-chrono-row > .map-control-button { flex-shrink: 0; padding-left: 8px; padding-right: 8px; }
.browser-chrono-row > .map-control-button:last-child { margin-right: 0; }
.browser-chrono-variant { white-space: normal; padding-top: 4px; padding-bottom: 4px; }
.browser-tile-list { flex-grow: 1; min-height: 0; }
.browser-tile-entry { min-height: 28px; margin: 0 0 3px; padding-left: var(--mf-space-2); padding-right: var(--mf-space-1); -unity-text-align: middle-left; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border-subtle); border-radius: var(--mf-radius-sm); }
.browser-tile-entry:hover { background-color: var(--mf-color-panel-hover); }
.browser-tile-entry-selected { border-color: var(--mf-color-accent); background-color: var(--mf-color-panel-hover); }
.browser-tile-entry-missing { color: var(--mf-color-error); }
.browser-tile-entry-edited { border-left-width: 3px; border-left-color: var(--mf-color-warning); }

/* Inspector */
.inspector-title { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-heading); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.inspector-property { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.inspector-property-name { width: 84px; min-width: 84px; margin-bottom: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.inspector-property-value { flex-grow: 1; flex-shrink: 1; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); white-space: normal; }
.inspector-tile-summary { margin-bottom: var(--mf-space-2); font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.inspector-tabs { flex-shrink: 0; margin-bottom: 0; }
.inspector-facts { margin-top: var(--mf-space-1); margin-bottom: var(--mf-space-2); }
.inspector-filter { margin-top: var(--mf-space-2); }
.compact-filter .unity-base-text-field__input { height: 30px; margin: 0; padding: 0 var(--mf-space-2); -unity-text-align: middle-left; }
.compact-filter .unity-base-text-field__input .unity-text-element { padding: 0; margin: 0; }
/* Tabs of the project browser (ADR 078) */
.project-tabs { flex-shrink: 0; margin-bottom: var(--mf-space-2); }
.project-tabs > .panel-tab { height: 26px; min-width: 0; padding-left: 2px; padding-right: 2px; font-size: var(--mf-font-secondary); }
.browser-page { flex-grow: 1; min-height: 0; }
.browser-tiles-tab { flex-grow: 1; min-height: 0; }
.browser-filter { flex-shrink: 0; margin-bottom: var(--mf-space-2); }
.browser-map-description-text { font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.inspector-records { flex-grow: 1; min-height: 0; margin-top: var(--mf-space-2); border-top-width: 1px; border-top-color: var(--mf-color-border-subtle); }
.inspector-section-heading { margin-top: var(--mf-space-3); margin-bottom: 5px; font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.inspector-record { margin-bottom: 4px; padding: 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-radius: var(--mf-radius-sm); white-space: normal; }
.junction-row { flex-direction: row; align-items: flex-start; margin-bottom: 4px; }
.junction-swatch { width: 9px; height: 9px; margin-top: 4px; margin-right: 8px; margin-left: 2px; flex-shrink: 0; rotate: 45deg; border-width: 2px; border-color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel-raised); }
.junction-swatch-connected { border-color: var(--mf-color-success); background-color: var(--mf-color-success); }
.junction-swatch-needsreview { border-color: var(--mf-color-warning); }
.junction-swatch-invalid { border-color: var(--mf-color-error); background-color: var(--mf-color-error); }
.junction-swatch-unconnected { border-color: var(--mf-color-text-secondary); }
.junction-text { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); }
.inspector-record-empty { margin-bottom: 5px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-muted); white-space: normal; }
.inspector-record-clickable:hover { background-color: var(--mf-color-panel-hover); }
.inspector-record-selected { background-color: var(--mf-color-panel-hover); border-left-width: 3px; border-left-color: var(--mf-color-accent); }
.inspector-edit { margin-top: var(--mf-space-2); padding: var(--mf-space-2); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); }
.inspector-edit-name { margin-bottom: 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); white-space: normal; }
.inspector-edit-field { margin: 2px 0; }
.inspector-edit-field > Label { min-width: 84px; width: 84px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.inspector-edit-apply { margin-top: 6px; align-self: flex-start; }
.inspector-edit-revert { margin-top: 6px; align-self: flex-start; }
.inspector-edit-delete { margin-top: 6px; align-self: flex-start; color: var(--mf-color-error); }
.inspector-edit-hint { margin-top: 6px; font-size: var(--mf-font-secondary); }
/* Groups that fold, compact rows and the bar of buttons under the scrolling part of the inspector (ADR 077) */
.inspector-group { margin-top: 4px; border-top-width: 1px; border-top-color: var(--mf-color-border-subtle); }
.inspector-group-header { flex-direction: row; align-items: center; height: 28px; }
.inspector-group-chevron { width: 14px; height: 14px; margin-right: 6px; flex-shrink: 0; color: var(--mf-color-text-secondary); }
.inspector-group-title { flex-grow: 1; flex-shrink: 1; font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); white-space: normal; }
.inspector-group-header:hover .inspector-group-title, .inspector-group-header:hover .inspector-group-chevron { color: var(--mf-color-text-primary); }
.inspector-group-body { padding-bottom: 4px; }
.inspector-edit-row { flex-direction: row; }
.inspector-edit-row > .inspector-edit-field { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin: 2px 4px 2px 0; flex-direction: column; align-items: stretch; }
.inspector-edit-row > .inspector-edit-field > Label { width: auto; min-width: 0; margin: 0 0 1px; padding: 0; }
.inspector-actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: var(--mf-space-2); padding-top: var(--mf-space-2); border-top-width: 1px; border-top-color: var(--mf-color-border); }
.inspector-actions > .map-control-button { margin: 0 6px 4px 0; align-self: auto; }
.muted { color: var(--mf-color-text-muted); white-space: normal; }

/* Scroll bars: a thin dark track without arrow buttons */
.unity-scroller--vertical { width: 8px; margin-left: var(--mf-space-1); border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { width: 8px; left: 0; border-width: 0; border-radius: var(--mf-radius-sm); background-color: var(--mf-color-panel); }
.unity-scroller--vertical .unity-base-slider__dragger { width: 8px; left: 0; border-width: 0; border-radius: var(--mf-radius-sm); background-color: var(--mf-color-border); }
.unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--mf-color-text-muted); }
.unity-scroller--vertical > .unity-scroller__slider { margin: 0; top: 0; bottom: 0; }

/* Foldouts */
.unity-foldout__toggle { margin-left: 0; }
.unity-foldout__text { color: var(--mf-color-text-secondary); font-size: var(--mf-font-secondary); }
.unity-foldout__checkmark { -unity-background-image-tint-color: var(--mf-color-text-secondary); }
.unity-foldout__content { margin-left: 15px; }

/* Buttons and fields shared by panels and dialogs */
.map-control-button { height: 28px; margin-right: 6px; padding-left: 10px; padding-right: 10px; color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.map-control-button:hover { background-color: var(--mf-color-panel-hover); }
.inspector-edit-field .unity-base-text-field__input, .dialog-field .unity-base-text-field__input { background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.inspector-edit-field .unity-base-text-field__input:focus, .dialog-field .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }

/* Dialogs */
.dialog-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(10, 12, 15, 0.7); }
.dialog { width: 560px; padding: var(--mf-space-4); background-color: var(--mf-color-panel-raised); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-lg); }
.dialog-field { margin: 4px 8px; }
.dialog-field > Label { min-width: 110px; width: 110px; color: var(--mf-color-text-secondary); }
.export-target { margin-top: 8px; color: var(--mf-color-info); }
.export-problem { color: var(--mf-color-error); }
.dialog-buttons { flex-direction: row; justify-content: flex-end; margin-top: var(--mf-space-3); }
.dialog-primary { background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); color: var(--mf-color-bg); -unity-font: url("Fonts/Inter-SemiBold.ttf"); }
.dialog-primary:hover { background-color: var(--mf-color-accent-hover); }

/* Status bar */
/* The status line is a dark strip in the lower row of the bottom bar */
.status-bar { height: 28px; min-height: 28px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; margin: 0 var(--mf-space-3) 6px var(--mf-space-3); padding-left: var(--mf-space-3); padding-right: var(--mf-space-3); background-color: rgba(41, 49, 61, 0.7); border-width: 1px; border-color: rgba(65, 75, 89, 0.7); border-radius: 14px; color: var(--mf-color-text-secondary); font-size: 12px; }
.bottom-bar-empty .status-bar { margin-bottom: 3px; height: 26px; }
.status-bar > Label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-pointer { display: none; }
.status-selection { flex-shrink: 0; margin-right: var(--mf-space-3); color: var(--mf-color-accent); }
.status-message { flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-center; color: var(--mf-color-text-primary); }
.status-map-state { display: none; }

/* New map dialog (ADR 032) */
.new-map-dialog { width: 880px; max-height: 94%; }
.new-map-body { flex-shrink: 1; min-height: 0; margin-top: var(--mf-space-1); }
.new-map-columns { flex-direction: row; }
.new-map-column { flex-grow: 1; flex-basis: 0; margin: 0 var(--mf-space-2); }
.new-map-section { margin: var(--mf-space-3) var(--mf-space-2) var(--mf-space-1); }
.new-map-row { min-height: 28px; justify-content: flex-start; }
.new-map-row-tall { align-items: flex-start; }
.new-map-label { width: 120px; min-width: 120px; }
.new-map-value { flex-grow: 1; flex-shrink: 1; margin: 0 var(--mf-space-2) 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mf-color-text-primary); }
.new-map-small-button { height: 26px; margin: 0; }
.new-map-field { flex-grow: 1; flex-shrink: 1; width: auto; }
.new-map-number { flex-grow: 0; width: 76px; }
.new-map-description { height: 58px; }
.new-map-description .unity-base-text-field__input { height: 58px; padding: 4px 6px; -unity-text-align: upper-left; white-space: normal; }
.new-map-hint { margin: 0 0 var(--mf-space-1) 120px; font-size: 10px; color: var(--mf-color-text-muted); white-space: normal; }
.new-map-dash { margin: 0 6px; color: var(--mf-color-text-secondary); }
.new-map-slider { flex-grow: 1; margin: 0 var(--mf-space-2) 0 0; }
.new-map-slider .unity-base-slider__tracker { height: 4px; margin-top: -2px; background-color: var(--mf-color-field); border-color: var(--mf-color-border); border-radius: 2px; }
.new-map-slider .unity-base-slider__dragger { width: 14px; height: 14px; margin-top: -7px; background-color: var(--mf-color-accent); border-color: var(--mf-color-accent); border-radius: 7px; }
.new-map-slider .unity-base-slider__dragger-border { display: none; }
.new-map-factor { width: 44px; -unity-text-align: middle-right; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); }
.new-map-dropdown { flex-grow: 1; flex-shrink: 1; margin: 0; }
.new-map-dropdown .unity-base-popup-field__input { height: 26px; margin: 0; padding: 0 6px; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.new-map-dropdown .unity-base-popup-field__input:hover { border-color: var(--mf-color-accent); }
.settings-language-slot { width: 220px; flex-grow: 0; flex-shrink: 0; margin: 0 8px; }
.settings-dropdown { width: 100%; flex-grow: 0; }
.settings-toggle { margin: var(--mf-space-1) var(--mf-space-2) 0; }
.settings-toggle > .unity-label { min-width: 0; color: var(--mf-color-text-primary); }
.new-map-seasons { margin: 0 var(--mf-space-2); }
.new-map-swatches { height: 108px; flex-shrink: 0; margin: 0 var(--mf-space-2); }
.new-map-swatches-content { flex-direction: row; }
.new-map-swatch { width: 80px; margin: 0 var(--mf-space-2) 0 0; padding: 4px; align-items: center; background-color: var(--mf-color-panel); border-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: var(--mf-radius-md); }
.new-map-swatch:hover { border-color: var(--mf-color-border); }
.new-map-swatch-selected, .new-map-swatch-selected:hover { border-color: var(--mf-color-accent); }
.new-map-swatch-image { width: 64px; height: 64px; align-items: center; justify-content: center; border-radius: var(--mf-radius-sm); -unity-background-scale-mode: scale-and-crop; }
.new-map-swatch-image > .spinner { width: 20px; height: 20px; color: var(--mf-color-accent); }
.new-map-swatch-name { max-width: 70px; margin-top: 2px; font-size: 10px; color: var(--mf-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bug-report-dialog { width: 640px; max-height: 94%; }
.bug-report-row { flex-direction: row; align-items: center; min-height: 30px; margin: 2px 8px; }
.bug-report-row-tall { align-items: flex-start; }
.bug-report-row-tall > .bug-report-label { margin-top: 6px; }
.bug-report-label { width: 110px; min-width: 110px; color: var(--mf-color-text-secondary); }
.bug-report-field { flex-grow: 1; flex-shrink: 1; width: auto; margin: 0; }
.bug-report-text { height: 72px; }
.bug-report-text .unity-base-text-field__input { height: 72px; padding: 4px 6px; -unity-text-align: upper-left; white-space: normal; }
.bug-report-toggle { margin: 0; color: var(--mf-color-text-primary); }
.bug-report-hint { margin: 2px 8px 0 126px; font-size: 10px; color: var(--mf-color-text-muted); white-space: normal; }
.update-dialog { width: 560px; max-height: 90%; }
.update-message-row { flex-direction: row; align-items: center; }
.update-spinner { width: 18px; height: 18px; margin-left: 8px; flex-shrink: 0; color: var(--mf-color-accent); }
.update-message { flex-grow: 1; flex-shrink: 1; }
.update-error { color: var(--mf-color-error); }
.update-notes { flex-shrink: 1; max-height: 260px; margin: 6px 8px; padding: var(--mf-space-2) var(--mf-space-3); background-color: var(--mf-color-panel); border-radius: var(--mf-radius-md); }
.update-notes-text { margin: 0; white-space: normal; color: var(--mf-color-text-primary); }
.update-progress { height: 6px; margin: 8px 8px 4px; background-color: var(--mf-color-field); border-radius: 3px; overflow: hidden; }
.update-progress-fill { height: 100%; width: 0; background-color: var(--mf-color-accent); border-radius: 3px; }
.update-hint { margin: 4px 8px; font-size: 10px; color: var(--mf-color-text-muted); white-space: normal; }
.update-toggle { margin: 8px 8px 0; color: var(--mf-color-text-secondary); }
.update-skip { margin-right: auto; }
.satellite-frame { left: var(--mf-space-2); bottom: auto; width: 480px; max-height: 86%; }
.satellite-body { flex-grow: 0; flex-shrink: 1; }
.satellite-columns { flex-direction: row; }
.satellite-tab { margin: 0 var(--mf-space-2); }
.satellite-tabs { margin: 0 var(--mf-space-2) var(--mf-space-2); }
.satellite-footer { margin: 0 var(--mf-space-2) var(--mf-space-2); }
.satellite-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 var(--mf-space-2); }
.satellite-row { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.satellite-wrap { flex-wrap: wrap; }
.satellite-search { flex-grow: 1; flex-shrink: 1; width: auto; margin-right: 6px; }
.satellite-button { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-1); }
.satellite-button > .icon { width: 16px; height: 16px; margin-right: 6px; }
.satellite-button > Label { margin: 0; padding: 0; }
.satellite-results { margin-bottom: var(--mf-space-1); }
.satellite-result { height: 22px; margin: 1px 0; padding: 0 6px; -unity-text-align: middle-left; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: var(--mf-radius-sm); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.satellite-result:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.world-map { height: 230px; flex-shrink: 0; margin: var(--mf-space-1) 0 2px; background-color: var(--mf-color-field); border-width: 1px; border-color: var(--mf-color-border); border-radius: var(--mf-radius-md); --world-map-outline: var(--mf-color-text-primary); --world-map-anchor: var(--mf-color-accent); }
.satellite-attribution { margin-bottom: var(--mf-space-1); font-size: 10px; color: var(--mf-color-text-muted); white-space: normal; }
.satellite-note { margin: 2px 0 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); white-space: normal; }
.satellite-label { width: 120px; min-width: 120px; }
.satellite-progress { flex-grow: 1; flex-shrink: 1; margin-right: 6px; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); white-space: normal; }
.satellite-grow { flex-grow: 1; flex-shrink: 1; }
.satellite-inline-label { margin: 0 6px 0 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.satellite-number { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 6px 0 0; }
.satellite-number > Label { min-width: 0; width: auto; margin: 0 4px 0 0; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-secondary); }
.satellite-number .unity-base-text-field__input { height: 26px; margin: 0; padding: 0 6px; -unity-text-align: middle-left; background-color: var(--mf-color-field); color: var(--mf-color-text-primary); border-color: var(--mf-color-border); border-radius: var(--mf-radius-sm); }
.satellite-number .unity-base-text-field__input:focus { border-color: var(--mf-color-accent); }
.satellite-mirror { margin-right: var(--mf-space-3); }
.satellite-warning { color: var(--mf-color-warning); }
.satellite-wide-field { flex-grow: 1; flex-shrink: 1; width: auto; margin-right: 6px; }
.satellite-foldout { margin-top: var(--mf-space-2); }
.satellite-foldout .unity-foldout__text { font-size: var(--mf-font-secondary); -unity-font: url("Fonts/Inter-SemiBold.ttf"); color: var(--mf-color-text-secondary); }
.satellite-foldout .unity-foldout__checkmark { -unity-background-image-tint-color: var(--mf-color-text-secondary); }
.satellite-foldout > .unity-foldout__content { margin-left: 0; }
.satellite-result-chosen, .satellite-result-chosen:hover { color: var(--mf-color-text-primary); background-color: var(--mf-color-panel-hover); }
.imagery-attribution { position: absolute; right: var(--mf-space-2); bottom: 104px; padding: 2px 6px; font-size: 10px; color: var(--mf-color-text-secondary); background-color: var(--mf-color-panel-glass); border-radius: var(--mf-radius-sm); }

/* Road builder (ADR 049): a cross-section of lanes above the lane settings, in place of the road picker */
.road-picker-new { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 0 0 var(--mf-space-2); }
.road-picker-new > .icon { width: 16px; height: 16px; margin-right: 6px; }
.road-picker-new > Label { margin: 0; padding: 0; }
.road-builder { height: auto; min-height: 362px; }
.road-builder-name { width: 220px; margin: 0 var(--mf-space-2); flex-shrink: 0; }
.road-builder-lanes { height: 112px; margin-bottom: var(--mf-space-3); background-color: var(--mf-color-field); border-radius: var(--mf-radius-md); overflow: hidden; }
.road-builder-lane-row { flex-grow: 1; flex-direction: row; align-items: stretch; }
.road-builder-lane { flex-basis: 0; min-width: 26px; margin-top: 22px; align-items: center; justify-content: center; background-color: var(--mf-color-lane-asphalt); border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.road-builder-lane-raised { margin-top: 8px; }
.road-builder-lane-walk { background-color: var(--mf-color-lane-walk); }
.road-builder-lane-median { background-color: var(--mf-color-lane-grass); }
.road-builder-lane-shoulder { background-color: var(--mf-color-lane-shoulder); }
.road-builder-lane:hover { border-color: var(--mf-color-text-secondary); }
.road-builder-lane-selected, .road-builder-lane-selected:hover { border-color: var(--mf-color-accent); }
.road-builder-lane-arrow { width: 20px; height: 20px; margin-bottom: 2px; color: var(--mf-color-text-primary); }
.road-builder-lane-kind { margin: 0; padding: 0; font-size: var(--mf-font-secondary); color: var(--mf-color-text-primary); }
.road-builder-lane-width { margin: 0; padding: 0; font-size: 10px; color: var(--mf-color-text-primary); }
.road-builder-lane-walk > Label { color: var(--mf-color-bg); }
.road-builder-markings { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.road-builder-bottom { flex-direction: row; }
.road-builder-column { flex-grow: 1; flex-basis: 0; margin-right: var(--mf-space-4); }
.road-builder-lane-options { margin-right: 0; }
.road-builder-buttons { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--mf-space-2); }
.road-builder-buttons > .map-control-button { margin-bottom: var(--mf-space-1); }

.road-builder-lane-bus { background-color: var(--mf-color-lane-bus); }
.road-builder-lane-bike { background-color: var(--mf-color-lane-bike); }
.road-builder-lane-parking { background-color: var(--mf-color-lane-parking); }
.road-builder-rail { position: absolute; top: 0; bottom: 0; width: 2px; background-color: var(--mf-color-lane-rail); }
.road-builder-rail-left { left: 10%; }
.road-builder-rail-right { right: 10%; }
.road-builder-lane-row-icon { position: absolute; top: 3px; right: 3px; width: 14px; height: 14px; color: var(--mf-color-text-primary); }
.road-builder-every { width: 56px; flex-grow: 0; margin-right: var(--mf-space-2); }
.inspector-rule-lanes { flex-wrap: wrap; margin-bottom: var(--mf-space-2); }
.inspector-rule-whole { align-self: flex-start; margin: 0 0 var(--mf-space-2); }
.inspector-rule-apply { align-self: flex-end; margin: var(--mf-space-2) 0 var(--mf-space-3); }
.road-builder-lane-textured { -unity-background-scale-mode: scale-and-crop; }
.road-builder-lane-textured > Label, .road-builder-lane-textured > .icon { color: var(--mf-color-text-primary); background-color: rgba(23, 28, 35, 0.6); border-radius: var(--mf-radius-sm); padding: 0 3px; }
.road-builder-choices { flex-wrap: wrap; margin-bottom: var(--mf-space-2); }
.road-builder-choices > .panel-tab { flex-grow: 1; flex-basis: 23%; height: 26px; padding: 0 4px; font-size: var(--mf-font-secondary); }
.road-builder-remove { color: var(--mf-color-error); }
.road-builder-surface { max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.road-builder-surfaces { height: 250px; }
.road-builder-surface-header { flex-direction: row; align-items: center; margin-bottom: var(--mf-space-2); }
.road-builder-grow { flex-grow: 1; margin-bottom: 0; }
.road-builder-surface-tiles { flex-grow: 1; min-height: 0; }

/* Ground texture painting (ADR 091) */
.ground-texture-list { margin: 2px 0 6px 0; }
.ground-texture-row { flex-direction: row; align-items: center; height: 28px; margin: 0 0 2px 0; padding: 0 6px; background-color: var(--mf-color-field); border-color: var(--mf-color-border); border-width: 1px; border-radius: var(--mf-radius-sm); }
.ground-texture-row:hover { border-color: var(--mf-color-accent); }
.ground-texture-chosen { border-color: var(--mf-color-accent); background-color: rgba(240, 138, 50, 0.18); }
.ground-texture-swatch { width: 20px; height: 20px; margin: 0 8px 0 0; border-radius: 3px; border-color: var(--mf-color-border); border-width: 1px; flex-shrink: 0; }
.ground-texture-name { flex-grow: 1; flex-shrink: 1; overflow: hidden; color: var(--mf-color-text-primary); -unity-text-align: middle-left; font-size: 12px; }

/* Every text input of the app, also Integer/Float/DoubleField (their input is a .unity-base-text-field__input as well): a light caret,
   a visible selection and an accent border while focused. The class is doubled to outrank the default theme. The border colour changes
   only, so nothing moves. Keep this at the end: it must come after the per-field rules above. Unity 6.6 has no caret blink for UI Toolkit. */
.unity-base-text-field__input.unity-base-text-field__input, .unity-base-text-field__input.unity-base-text-field__input .unity-text-element { --unity-cursor-color: var(--mf-color-text-primary); --unity-selection-color: var(--mf-color-selection); }
.unity-base-text-field__input.unity-base-text-field__input:focus { border-color: var(--mf-color-accent-hover); }
